    },
    {
      "from": "REQUESTING",
      "event": "DHCPNAK",
      "action": "Restart configuration process",
      "to": "INIT"
    },
    {
      "from": "INIT-REBOOT",
      "event": "Send DHCPREQUEST",
      "action": "Broadcast DHCPREQUEST",
      "to": "REBOOTING"
    },
    {
      "from": "REBOOTING",
      "event": "DHCPACK",
      "action": "Record lease, set timers T1, T2",
      "to": "BOUND"
    },
    {
