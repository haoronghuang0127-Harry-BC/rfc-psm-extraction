{
  "states": [
    "Not Authenticated",
    "Authenticated",
    "Selected",
    "Logout",
    "Any State",
    "Not Authenticated State",
    "Authenticated State",
    "Selected State",
    "unauthenticated",
    "authenticated",
    "Initial",
    "TLS Negotiated"
  ],
  "transitions": [
    {
      "from": "",
      "event": "connection without pre-authentication (OK greeting)",
      "action": "",
      "to": "Not Authenticated"
    },
    {
      "from": "",
      "event": "pre-authenticated connection (PREAUTH greeting)",
      "action": "",
      "to": "Authenticated"
    },
    {
      "from": "",
      "event": "rejected connection (BYE greeting)",
      "action": "",
      "to": "Logout"
    },
    {
      "from": "Not Authenticated",
      "event": "successful LOGIN or AUTHENTICATE command",
      "action": "",
      "to": "Authenticated"
    },
    {
      "from": "Authenticated",
      "event": "successful SELECT or EXAMINE command",
      "action": "",
      "to": "Selected"
    },
    {
      "from": "Authenticated",
      "event": "CLOSE or UNSELECT command, unsolicited CLOSED response code, or failed SELECT or EXAMINE command",
      "action": "",
      "to": "Authenticated"
    },
    {
      "from": "Selected",
      "event": "LOGOUT command, server shutdown, or connection closed",
      "action": "",
      "to": "Logout"
    },
    {
      "from": "Authenticated",
      "event": "LOGOUT command, server shutdown, or connection closed",
      "action": "",
      "to": "Logout"
    },
    {
      "from": "Any State",
      "event": "CAPABILITY",
      "action": "OK - capability completed",
      "to": "Any State"
    },
    {
      "from": "Any State",
      "event": "NOOP",
      "action": "OK - noop completed",
      "to": "Any State"
    },
    {
      "from": "Any State",
      "event": "LOGOUT",
      "action": "OK - logout completed",
      "to": "Not Authenticated State"
    },
    {
      "from": "Any State",
      "event": "STARTTLS",
      "action": "OK - starttls completed, begin TLS negotiation",
      "to": "Not Authenticated State"
    },
    {
      "from": "Not Authenticated State",
      "event": "AUTHENTICATE",
      "action": "OK - authenticate completed",
      "to": "Authenticated State"
    },
    {
      "from": "Not Authenticated State",
      "event": "LOGIN",
      "action": "OK - login completed",
      "to": "Authenticated State"
    },
    {
      "from": "Not Authenticated State",
      "event": "AUTHENTICATE",
      "action": "NO - authenticate failure",
      "to": "Not Authenticated State"
    },
    {
      "from": "Not Authenticated State",
      "event": "LOGIN",
      "action": "NO - login failure",
      "to": "Not Authenticated State"
    },
    {
      "from": "Authenticated State",
      "event": "ENABLE",
      "action": "OK - Relevant capabilities enabled",
      "to": "Authenticated State"
    },
    {
      "from": "Authenticated State",
      "event": "SELECT",
      "action": "OK - select completed",
      "to": "Selected State"
    },
    {
      "from": "Authenticated State",
      "event": "EXAMINE",
      "action": "OK - examine completed",
      "to": "Selected State"
    },
    {
      "from": "Selected State",
      "event": "CLOSE",
      "action": "OK - close completed",
      "to": "Authenticated State"
    },
    {
      "from": "Selected State",
      "event": "UNSELECT",
      "action": "OK - unselect completed",
      "to": "Authenticated State"
    },
    {
      "from": "Selected State",
      "event": "EXPUNGE",
      "action": "OK - expunge completed",
      "to": "Selected State"
    },
    {
      "from": "Selected State",
      "event": "SEARCH",
      "action": "OK - search completed",
      "to": "Selected State"
    },
    {
      "from": "Selected State",
      "event": "FETCH",
      "action": "OK - fetch completed",
      "to": "Selected State"
    },
    {
      "from": "Selected State",
      "event": "STORE",
      "action": "OK - store completed",
      "to": "Selected State"
    },
    {
      "from": "Selected State",
      "event": "COPY",
      "action": "OK - copy completed",
      "to": "Selected State"
    },
    {
      "from": "Selected State",
      "event": "MOVE",
      "action": "OK - move completed",
      "to": "Selected State"
    },
    {
      "from": "Selected State",
      "event": "UID",
      "action": "OK - UID command completed",
      "to": "Selected State"
    },
    {
      "from": "unauthenticated",
      "event": "PREAUTH",
      "action": "",
      "to": "authenticated"
    },
    {
      "from": "unauthenticated",
      "event": "OK",
      "action": "",
      "to": "authenticated"
    },
    {
      "from": "unauthenticated",
      "event": "BYE",
      "action": "",
      "to": "unauthenticated"
    },
    {
      "from": "Initial",
      "event": "starttls",
      "action": "OK Proceed with TLS negotiation",
      "to": "TLS Negotiated"
    },
    {
      "from": "TLS Negotiated",
      "event": "AUTHENTICATE SCRAM-SHA-256",
      "action": "SCRAM-SHA-256 authentication successful",
      "to": "Authenticated"
    },
    {
      "from": "Authenticated",
      "event": "ENABLE IMAP4rev2",
      "action": "Some capabilities enabled",
      "to": "Authenticated"
    },
    {
      "from": "Authenticated",
      "event": "select inbox",
      "action": "[READ-WRITE] SELECT completed",
      "to": "Selected"
    }
  ]
}