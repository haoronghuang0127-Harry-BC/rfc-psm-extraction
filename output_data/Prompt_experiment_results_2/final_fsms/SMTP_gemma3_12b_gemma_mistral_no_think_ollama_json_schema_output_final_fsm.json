      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "RCPT TO:<Admin.MRC@foo.com>",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "DATA",
      "action": "354 Start mail input; end with <CRLF>.<CRLF>",
      "to": "Data Input"
    },
    {
      "from": "Data Input",
      "event": "Blah blah blah... ...etc. etc. etc.\n.",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "QUIT",
      "action": "221 foo.com Service closing transmission channel",
      "to": "Idle"
