{
  "states": [
    "Session Initiation",
    "Mail Transactions",
    "Forwarding for Address Correction or Updating",
    "Commands for Debugging Addresses",
    "Relaying and Mail Routing",
    "Mail Gatewaying",
    "Terminating Sessions and Connections",
    "Mailing Lists and Aliases",
    "Initial State",
    "Mail Transaction in Progress",
    "Locating the Target Host",
    "Resolving the Domain Name",
    "Queued and Retried",
    "Error Condition",
    "Server Receiving Source Route",
    "Server Forwarding with Route Modification",
    "Idle",
    "Connected",
    "Data Input",
    "Closing",
    "Authenticated State",
    "Unauthenticated State"
  ],
  "transitions": [
    {
      "from": "Session Initiation",
      "event": "client opens a connection",
      "action": "server responds with an opening message",
      "to": "Session Initiation"
    },
    {
      "from": "Session Initiation",
      "event": "554 response in initial connection opening message",
      "action": "MUST still wait for the client to send a QUIT",
      "to": "Session Initiation"
    },
    {
      "from": "Mail Transactions",
      "event": "MAIL command",
      "action": "reset all its state tables and buffers",
      "to": "Mail Transactions"
    },
    {
      "from": "Mail Transactions",
      "event": "RCPT command",
      "action": "stores the forward-path",
      "to": "Mail Transactions"
    },
    {
      "from": "Mail Transactions",
      "event": "DATA command",
      "action": "considers all succeeding lines up to but not including the end of mail data indicator to be the message text",
      "to": "Mail Transactions"
    },
    {
      "from": "Forwarding for Address Correction or Updating",
      "event": "",
      "action": "",
      "to": "Forwarding for Address Correction or Updating"
    },
    {
      "from": "Commands for Debugging Addresses",
      "event": "VRFY command",
      "action": "MAY include the full name of the user and MUST include the mailbox of the user",
      "to": "Commands for Debugging Addresses"
    },
    {
      "from": "Commands for Debugging Addresses",
      "event": "EXPN command",
      "action": "MAY include the full name of the users and MUST give the mailboxes on the mailing list",
      "to": "Commands for Debugging Addresses"
    },
    {
      "from": "Relaying and Mail Routing",
      "event": "explicit source routes",
      "action": "servers MAY decline to act as mail relays",
      "to": "Relaying and Mail Routing"
    },
    {
      "from": "Mail Gatewaying",
      "event": "message is gatewayed",
      "action": "MUST prepend a Received: line",
      "to": "Mail Gatewaying"
    },
    {
      "from": "Mailing Lists and Aliases",
      "event": "message is delivered",
      "action": "MUST be changed to be the address of a list administrator",
      "to": "Mailing Lists and Aliases"
    },
    {
      "from": "Initial State",
      "event": "EHLO or HELO",
      "action": "Clear state tables and buffers",
      "to": "Initial State"
    },
    {
      "from": "Initial State",
      "event": "MAIL",
      "action": "Clear reverse-path, forward-path, and mail data buffers; insert reverse-path information",
      "to": "Mail Transaction in Progress"
    },
    {
      "from": "Mail Transaction in Progress",
      "event": "RSET",
      "action": "Abort transaction; clear buffers and state tables",
      "to": "Initial State"
    },
    {
      "from": "Mail Transaction in Progress",
      "event": "QUIT",
      "action": "Send OK reply and close transmission channel",
      "to": "Initial State"
    },
    {
      "from": "Mail Transaction in Progress",
      "event": "DATA",
      "action": "Append mail data to mail data buffer",
      "to": "Mail Transaction in Progress"
    },
    {
      "from": "Locating the Target Host",
      "event": "DNS lookup",
      "action": "MUST be performed to resolve the domain name",
      "to": "Resolving the Domain Name"
    },
    {
      "from": "Resolving the Domain Name",
      "event": "non-existent domain error",
      "action": "MUST be reported as an error",
      "to": "Error Condition"
    },
    {
      "from": "Resolving the Domain Name",
      "event": "temporary error",
      "action": "MUST be queued and retried later",
      "to": "Queued and Retried"
    },
    {
      "from": "Resolving the Domain Name",
      "event": "empty list of MXs",
      "action": "treated as if it was associated with an implicit MX RR",
      "to": "Resolving the Domain Name"
    },
    {
      "from": "Resolving the Domain Name",
      "event": "no usable MX records",
      "action": "MUST be reported as an error",
      "to": "Error Condition"
    },
    {
      "from": "Resolving the Domain Name",
      "event": "one or more MX RRs are found",
      "action": "MUST NOT utilize any address RRs associated with that name unless they are located using the MX RRs",
      "to": "Resolving the Domain Name"
    },
    {
      "from": "Resolving the Domain Name",
      "event": "domain name associated with an MX RR is looked up",
      "action": "MUST contain a domain name",
      "to": "Resolving the Domain Name"
    },
    {
      "from": "Resolving the Domain Name",
      "event": "domain name queried",
      "action": "MUST return at least one address record",
      "to": "Resolving the Domain Name"
    },
    {
      "from": "Initial State",
      "event": "MAIL command",
      "action": "SHOULD NOT appear in reverse-path",
      "to": "Server Receiving Source Route"
    },
    {
      "from": "Server Receiving Source Route",
      "event": "Forwarding",
      "action": "MUST remove domain name and MAY remove other source routing information",
      "to": "Server Forwarding with Route Modification"
    },
    {
      "from": "Idle",
      "event": "220 foo.com Simple Mail Transfer Service Ready",
      "action": "220 foo.com Simple Mail Transfer Service Ready",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "EHLO bar.com",
      "action": "250-foo.com greets bar.com\n250-8BITMIME\n250-SIZE\n250-DSN\n250 HELP",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "MAIL FROM:<Smith@bar.com>",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "RCPT TO:<Jones@foo.com>",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "RCPT TO:<Green@foo.com>",
      "action": "550 No such user here",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "RCPT TO:<Brown@foo.com>",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "DATA",
      "action": "354 Start mail input; end with <CRLF>.<CRLF>",
      "to": "Data Input"
    },
    {
      "from": "Data Input",
      "event": "Blah blah blah... ...etc. etc. etc.\n.",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "QUIT",
      "action": "221 foo.com Service closing transmission channel",
      "to": "Idle"
    },
    {
      "from": "Connected",
      "event": "RSET",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "220 foo.com Simple Mail Transfer Service Ready",
      "action": "220 foo.com Simple Mail Transfer Service Ready",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "EHLO bar.com",
      "action": "250-foo.com greets bar.com\n250-8BITMIME\n250-SIZE\n250-DSN\n250 HELP",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "MAIL FROM:<JQP@bar.com>",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "RCPT TO:<Jones@XYZ.COM>",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "DATA",
      "action": "354 Start mail input; end with <CRLF>.<CRLF>",
      "to": "Data Input"
    },
    {
      "from": "Data Input",
      "event": "Date: Thu, 21 May 1998 05:33:29 -0700\nFrom: John Q. Public <JQP@bar.com>\nSubject: The Next Meeting of the Board\nTo: Jones@xyz.com\n\nBill:\nThe next meeting of the board of directors will be\non Tuesday.\nJohn.\n.",
      "action": "250 OK",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "QUIT",
      "action": "221 foo.com Service closing transmission channel",
      "to": "Idle"
    },
    {
      "from": "Connected",
      "event": "EHLO bar.com",
      "action": "250-foo.com greets bar.com\n250-8BITMIME\n250-SIZE\n250-DSN\n250-VRFY\n250 HELP",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "VRFY Crispin",
      "action": "250 Mark Crispin <Admin.MRC@foo.com>",
      "to": "Connected"
    },
    {
      "from": "Connected",
