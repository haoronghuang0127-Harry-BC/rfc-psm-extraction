  "transitions": [
    {
      "from": "Logged Out",
      "event": "USER",
      "action": "Reply 331 (User name okay, need password)",
      "to": "User Name Sent"
    },
    {
      "from": "Logged Out",
      "event": "USER",
      "action": "Flush user/password/account info; begin login sequence again",
      "to": "User Name Sent"
    },
    {
      "from": "User Name Sent",
      "event": "PASS",
      "action": "Reply 332 (Need account for login)",
      "to": "Account Required for Login"
    },
    {
      "from": "User Name Sent",
      "event": "PASS",
      "action": "Reply 230 (User logged in, proceed)",
      "to": "Logged In"
    },
    {
      "from": "Account Required for Login",
      "event": "ACCT",
      "action": "Complete login sequence",
      "to": "Logged In"
    },
    {
      "from": "Logged In",
      "event": "STOR or APPE",
      "action": "Reply 332 (Need account for storing files) or 532",
      "to": "Account Required for Storing Files"
    },
    {
      "from": "Account Required for Storing Files",
      "event": "ACCT",
      "action": "Store pending command or proceed with transfer",
      "to": "Logged In"
    },
    {
      "from": "Logged In",
      "event": "REST",
      "action": "Skip to specified data checkpoint; wait for service command",
      "to": "Restart Marker Set"
    },
    {
      "from": "Restart Marker Set",
      "event": "STOR or RETR",
      "action": "Resume file transfer from marker",
      "to": "Logged In"
    },
    {
      "from": "Logged In",
      "event": "RNFR",
      "action": "Specify old pathname; wait for RNTO",
      "to": "Rename From Specified"
    },
    {
      "from": "Rename From Specified",
      "event": "RNTO",
      "action": "Rename file to new pathname",
      "to": "Logged In"
    },
    {
      "from": "Logged Out",
      "event": "REIN",
      "action": "Reset parameters to default; control connection remains open",
      "to": "Logged Out"
    },
    {
      "from": "Logged In",
      "event": "QUIT",
      "action": "Terminate USER; close control connection if no transfer in progress",
      "to": "Logged Out"
    },
