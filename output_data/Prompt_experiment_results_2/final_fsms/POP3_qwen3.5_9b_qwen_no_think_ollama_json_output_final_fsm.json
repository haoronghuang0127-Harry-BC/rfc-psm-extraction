{
  "states": [
    "AUTHORIZATION",
    "TRANSACTION",
    "UPDATE"
  ],
  "transitions": [
    {
      "from": "AUTHORIZATION",
      "event": "",
      "action": "client identifies itself; server acquires resources",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "QUIT command",
      "action": "server releases resources and says goodbye",
      "to": "UPDATE"
    },
    {
      "from": "UPDATE",
      "event": "",
      "action": "TCP connection is closed",
      "to": ""
    },
    {
      "from": "AUTHORIZATION",
      "event": "",
      "action": "+OK POP3 server ready",
      "to": "AUTHORIZATION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "USER and PASS command combination or APOP command",
      "action": "positive status indicator",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "negative status indicator",
      "action": "",
      "to": "AUTHORIZATION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "QUIT command",
      "action": "+OK",
      "to": "AUTHORIZATION"
    },
    {
      "from": "TRANSACTION",
      "event": "QUIT",
      "action": "",
      "to": "UPDATE"
    },
    {
      "from": "",
