{
  "states": [
    "CLOSED",
    "LISTEN",
    "REQUEST",
    "RESPOND",
    "PARTOPEN",
    "OPEN",
    "CLOSEREQ",
    "CLOSING",
    "TIMEWAIT",
    "STABLE",
    "CHANGING",
    "UNSTABLE",
    "Bidirectional",
    "Unidirectional",
    "ECN Incapable",
    "ECN Capable",
    "packet received",
    "packet ECN marked",
    "packet not yet received"
  ],
  "transitions": [
    {
      "from": "CLOSED",
      "event": "send DCCP-Request",
      "action": "",
      "to": "REQUEST"
    },
    {
      "from": "LISTEN",
      "event": "receive DCCP-Request",
      "action": "send DCCP-Response",
      "to": "RESPOND"
    },
    {
      "from": "REQUEST",
      "event": "receive DCCP-Response",
      "action": "",
      "to": "PARTOPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "send DCCP-Ack or DCCP-DataAck",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "receive DCCP-Ack or DCCP-DataAck",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "OPEN",
      "event": "send DCCP-CloseReq",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "OPEN",
      "event": "send DCCP-Close",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSEREQ",
      "event": "receive DCCP-Close",
      "action": "send DCCP-Reset",
      "to": "CLOSED"
    },
    {
      "from": "CLOSING",
      "event": "receive DCCP-Reset",
      "action": "",
      "to": "TIMEWAIT"
    },
    {
      "from": "STABLE",
      "event": "snd Change L",
      "action": "",
      "to": "CHANGING"
    },
    {
      "from": "STABLE",
      "event": "rcv Confirm R",
      "action": "ignore",
      "to": "STABLE"
    },
    {
      "from": "STABLE",
      "event": "rcv Change R",
      "action": "calc new value, snd Confirm L",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv Confirm R",
      "action": "accept value",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv empty Confirm R",
      "action": "revert to old value",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "pref list changes",
      "action": "",
      "to": "UNSTABLE"
    },
    {
      "from": "CHANGING",
      "event": "timeout/rcv non-ack",
      "action": "snd Change L",
      "to": "CHANGING"
    },
    {
      "from": "UNSTABLE",
      "event": "snd Change L",
      "action": "",
      "to": "CHANGING"
    },
    {
      "from": "UNSTABLE",
      "event": "rcv Confirm/Change R",
      "action": "ignore",
      "to": "UNSTABLE"
    },
    {
      "from": "REQUEST",
      "event": "receive sequence-valid DCCP-Sync",
      "action": "respond with DCCP-Reset",
      "to": "REQUEST"
    },
    {
      "from": "CLOSED",
      "event": "receive DCCP-Data",
      "action": "generate DCCP-Sync",
      "to": "CLOSED"
    },
    {
      "from": "CLOSED",
      "event": "passive open",
      "action": "",
      "to": "LISTEN"
    },
    {
      "from": "CLOSED",
      "event": "active open",
      "action": "send DCCP-Request",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "receive DCCP-Response",
      "action": "send DCCP-Ack or DCCP-DataAck",
      "to": "PARTOPEN"
    },
    {
      "from": "RESPOND",
      "event": "receive valid DCCP-Ack",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "timeout (not less than 4MSL)",
      "action": "send DCCP-Reset with Reset Code 2",
      "to": "CLOSED"
    },
    {
      "from": "PARTOPEN",
      "event": "receive valid packet other than DCCP-Response, DCCP-Reset, or DCCP-Sync",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "timeout (more than 4MSL)",
      "action": "send DCCP-Reset with Reset Code 2",
      "to": "CLOSED"
    },
    {
      "from": "OPEN",
      "event": "server decides to close without holding TIMEWAIT",
      "action": "send DCCP-CloseReq",
      "to": "CLOSEREQ"
    },
    {
      "from": "OPEN",
      "event": "client decides to close",
      "action": "send DCCP-Close",
      "to": "CLOSING"
    },
    {
      "from": "OPEN",
      "event": "server decides to hold TIMEWAIT",
      "action": "send DCCP-Close",
      "to": "CLOSING"
    },
    {
      "from": "TIMEWAIT",
      "event": "2MSL timer expires",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "REQUEST",
      "event": "give up after timeout",
      "action": "send DCCP-Reset with Reset Code 2",
      "to": "CLOSED"
    },
    {
      "from": "LISTEN",
      "event": "receive packet in LISTEN state (no socket)",
      "action": "generate DCCP-Reset with Reset Code 3",
      "to": "LISTEN"
    },
    {
      "from": "CLOSED",
      "event": "receive packet in CLOSED state",
      "action": "generate DCCP-Reset with Reset Code 3",
      "to": "CLOSED"
    },
    {
      "from": "TIMEWAIT",
      "event": "receive packet in TIMEWAIT state",
      "action": "generate DCCP-Reset with Reset Code 3",
      "to": "TIMEWAIT"
    },
    {
      "from": "Bidirectional",
      "event": "DCCP B goes quiescent",
      "action": "",
      "to": "Unidirectional"
    },
    {
      "from": "Unidirectional",
      "event": "receive DCCP-Data or DCCP-DataAck packet from DCCP B",
      "action": "",
      "to": "Bidirectional"
    },
    {
      "from": "ECN Capable",
      "event": "Change L(ECN Incapable, 1)",
      "action": "send packets as ECN incapable; use value zero for all ECN Nonce Echoes",
      "to": "ECN Incapable"
    },
    {
      "from": "ECN Capable",
      "event": "Confirm R(ECN Incapable, 1)",
      "action": "",
      "to": "ECN Incapable"
    },
    {
      "from": "packet not yet received",
      "event": "Packet arrival with Sequence Number S <= buf_ackno",
      "action": "Change byte's state to packet received or packet ECN marked; if state changes to packet received and ECN Nonce is 1, flip ack_nonce for every acknowledgement with ack_ackno >= S",
      "to": "packet received"
    },
    {
      "from": "packet not yet received",
      "event": "Packet arrival with Sequence Number S <= buf_ackno",
      "action": "Change byte's state to packet ECN marked; if state changes to packet received and ECN Nonce is 1, flip ack_nonce for every acknowledgement with ack_ackno >= S",
      "to": "packet ECN marked"
    },
    {
      "from": "packet not yet received",
      "event": "Packet arrival with Sequence Number greater than buf_ackno (intervening packets)",
      "action": "Enter intervening packets as packet not yet received",
      "to": "packet not yet received"
    }
  ]
}