{
  "states": [
    "Session Establishment",
    "Media Delivery Control",
    "Session Maintenance",
    "Init",
    "Ready",
    "Play"
  ],
  "transitions": [
    {
      "from": "",
      "event": "SETUP request",
      "action": "create RTSP session context",
      "to": "Session Establishment"
    },
    {
      "from": "Session Establishment",
      "event": "PLAY request",
      "action": "start controlling media delivery",
      "to": "Media Delivery Control"
    },
    {
      "from": "Media Delivery Control",
      "event": "",
      "action": "show liveness (keep-alive)",
      "to": "Session Maintenance"
    },
    {
      "from": "Init",
      "event": "SETUP",
      "action": "create session",
      "to": "Ready"
    },
    {
      "from": "Ready",
      "event": "PLAY",
      "action": "start sending data",
      "to": "Play"
    },
    {
      "from": "Ready",
      "event": "SETUP",
      "action": "change transport parameters",
      "to": "Ready"
    },
    {
      "from": "Play",
      "event": "PAUSE",
      "action": "interrupt delivery, set pause point",
      "to": "Ready"
    },
    {
      "from": "Play",
      "event": "PLAY",
      "action": "replace current PLAY action",
      "to": "Play"
    },
    {
      "from": "Play",
      "event": "SETUP",
      "action": "change transport parameters",
      "to": "Play"
    },
    {
      "from": "Ready",
      "event": "SETUP",
      "action": "create session",
      "to": "Init"
    },
    {
      "from": "Play",
      "event": "SETUP",
      "action": "change transport parameters",
      "to": "Ready"
    },
    {
      "from": "Init",
      "event": "SETUP",
      "action": "NRM=1, RP=0.0",
      "to": "Ready"
    },
    {
      "from": "Init",
      "event": "SETUP",
      "action": "3rr Redirect",
      "to": "Init"
    },
    {
      "from": "Init",
      "event": "S -> C: REDIRECT",
      "action": "Terminate all SES",
      "to": "Init"
    },
    {
      "from": "Ready",
      "event": "SETUP",
      "action": "NRM +=1",
      "to": "Ready"
    },
    {
      "from": "Ready",
      "event": "TEARDOWN",
      "action": "No session hdr, NRM = 0",
      "to": "Init"
    },
    {
      "from": "Ready",
      "event": "PLAY",
      "action": "Play from RP",
      "to": "Play"
    },
    {
      "from": "Ready",
      "event": "PAUSE",
      "action": "Return PP",
      "to": "Ready"
    },
    {
      "from": "Ready",
      "event": "SC:REDIRECT",
      "action": "Set RedP",
      "to": "Ready"
    },
    {
      "from": "Ready",
      "event": "Timeout",
      "action": "",
      "to": "Init"
    },
    {
      "from": "Ready",
      "event": "RedP reached",
      "action": "TEARDOWN of session",
      "to": "Init"
    },
    {
      "from": "Play",
      "event": "SETUP",
      "action": "455",
      "to": "Play"
    },
    {
      "from": "Play",
      "event": "SETUP",
      "action": "Change transport param.",
      "to": "Play"
    },
    {
      "from": "Play",
      "event": "TEARDOWN",
      "action": "No session hdr, NRM=0",
      "to": "Init"
    },
    {
      "from": "Play",
      "event": "SC:REDIRECT",
      "action": "Set RedP",
      "to": "Play"
    },
    {
      "from": "Play",
      "event": "SC:REDIRECT",
      "action": "Session is removed",
      "to": "Init"
    },
    {
      "from": "Play",
      "event": "RedP reached",
      "action": "TEARDOWN of session",
      "to": "Init"
    },
    {
      "from": "Play",
      "event": "Timeout",
      "action": "Stop Media playout",
      "to": "Init"
    }
  ]
}