    },
    {
      "from": "unidirectional connection",
      "event": "DCCP B sends a single DCCP-Data or DCCP-DataAck packet",
      "action": "DCCP A switches ack pattern",
      "to": "bidirectional connection"
    },
    {
      "from": "ECN capable",
      "event": "Change L(ECN Inapable, 1)",
      "action": "inform receiver that A cannot read ECN bits",
      "to": "ECN incapable"
    },
    {
      "from": "ECN incapable",
      "event": "Confirm R(ECN Incapable, 1)",
      "action": "MUST NOT accept any data",
      "to": "ECN incapable"
    },
    {
      "from": "ECN incapable",
      "event": "Data Dropped options",
      "action": "with Drop Code 0 (\"protocol constraints\")",
      "to": "ECN incapable"
    },
    {
      "from": "ECN capable",
      "event": "ECN Incapable/A is one",
      "action": "all of DCCP B's packets MUST be sent as ECN incapable",
      "to": "ECN incapable"
    },
    {
      "from": "ECN incapable",
      "event": "packets to an ECN-incapable receiver",
      "action": "MUST send its packets as ECN incapable",
      "to": "ECN incapable"
    },
    {
      "from": "ECN capable",
      "event": "ECN Incapable feature is unimplemented",
      "action": "acting as if all connections were ECN capable",
      "to": "ECN capable"
    },
    {
      "from": "PMTU Discovery",
      "event": "Datagram Too Big message received",
      "action": "decrease PMTU to Next-Hop MTU value",
      "to": "PMTU Discovery"
    },
    {
      "from": "PMTU Discovery",
      "event": "Datagram Too Big message with MTU = 0",
      "action": "choose PMTU using RFC1191 Section 7 algorithm",
      "to": "PMTU Discovery"
    },
    {
      "from": "PMTU Discovery",
      "event": "Datagram Too Big message with MTU > current PMTU",
      "action": "ignore message",
      "to": "PMTU Discovery"
    },
    {
      "from": "PMTU Discovery",
      "event": "application requests PMTU discovery",
      "action": "reset PMTU to outgoing interface's MTU, rate limit requests",
      "to": "PMTU Discovery"
    },
    {
      "from": "PMTU Discovery",
      "event": "ICMP Datagram Too Big message received",
      "action": "MAY ignore packet arrival indication, check ECN bits",
      "to": "PMTU Discovery"
    },
    {
      "from": "PMTU Discovery",
      "event": "incorrect/missing Sequence Number in ICMP message",
      "action": "MAY ignore message or temporarily lower PMTU",
      "to": "PMTU Discovery"
    },
    {
      "from": "PMTU Discovery",
      "event": "more than three odd Datagram Too Big messages and more than three lost packets",
      "action": "assume confused router, obey ICMP messages or switch to fragmentation",
      "to": "PMTU Discovery"
    },
    {
      "from": "Upward Probing",
      "event": "DCCP-Sync probe sent",
      "action": "insert arbitrary data, pad packet, expect DCCP-SyncAck",
      "to": "Upward Probing"
    },
    {
      "from": "HC-Receiver",
      "event": "Packet with Sequence Number greater than buf_ackno arrives",
      "action": "updates buf_head, buf_ackno, and possibly buf_nonce, in addition to the buffer itself",
      "to": "HC-Receiver"
    },
    {
      "from": "HC-Receiver",
      "event": "Packet with Sequence Number <= buf_ackno arrives",
      "action": "scan the table for the byte corresponding to S",
      "to": "HC-Receiver"
    },
    {
      "from": "HC-Receiver",
      "event": "HC-Sender packet arrives ECN marked",
      "action": "updates buffer state",
      "to": "HC-Receiver"
    },
    {
      "from": "HC-Receiver",
      "event": "HC-Sender packet arrives without ECN marking and with ECN Nonce 0",
      "action": "updates buffer state",
      "to": "HC-Receiver"
    },
    {
      "from": "HC-Receiver",
      "event": "HC-Sender packet arrives with ECN Nonce 1",
      "action": "updates buffer state",
      "to": "HC-Receiver"
    },
    {
      "from": "HC-Sender",
      "event": "receives an acknowledgement",
      "action": "reads off the number of packets that were dropped and/or ECN marked, check the ECN Nonce for correctness",
