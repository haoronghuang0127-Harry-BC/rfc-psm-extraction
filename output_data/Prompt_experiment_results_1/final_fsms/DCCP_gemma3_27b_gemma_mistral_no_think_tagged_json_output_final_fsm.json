    },
    {
      "from": "HC-Receiver",
      "event": "HC-Receiver needs to generate an acknowledgement",
      "action": "buffer's contents can simply be copied into one or more Ack Vector options",
      "to": "HC-Receiver"
    },
    {
      "from": "HC-Receiver",
      "event": "receives acknowledgement from HC-Sender with Acknowledgement Number",
      "action": "adjusts the run length, sets buf_tail, flips buf_nonce, throws away R and every preceding ack record",
      "to": "HC-Receiver"
    },
