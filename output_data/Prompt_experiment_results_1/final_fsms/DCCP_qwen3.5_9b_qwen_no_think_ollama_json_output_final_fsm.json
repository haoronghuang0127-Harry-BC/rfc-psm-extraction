{
  "states": [
    "CLOSED",
    "LISTEN",
    "REQUEST",
    "RESPOND",
    "PARTOPEN",
    "OPEN",
    "CLOSEREQ",
    "CLOSING",
    "TIMEWAIT",
    "STABLE",
    "CHANGING",
    "UNSTABLE"
  ],
  "transitions": [
    {
      "from": "CLOSED",
      "event": "",
      "action": "",
      "to": "LISTEN"
    },
    {
      "from": "REQUEST",
      "event": "DCCP-Response",
      "action": "",
      "to": "PARTOPEN"
    },
    {
      "from": "RESPOND",
      "event": "DCCP-Request",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "PARTOPEN",
      "event": "DCCP-Ack or DCCP-DataAck",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "CLOSEREQ",
      "event": "DCCP-CloseReq",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSING",
      "event": "DCCP-Reset",
      "action": "",
      "to": "TIMEWAIT"
    },
    {
      "from": "CLOSING",
      "event": "DCCP-Close",
      "action": "",
      "to": "TIMEWAIT"
    },
    {
      "from": "OPEN",
      "event": "DCCP-CloseReq",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "STABLE",
      "event": "",
      "action": "snd Change L",
      "to": "CHANGING"
    },
    {
      "from": "CHANGING",
      "event": "pref list changes",
      "action": "",
      "to": "UNSTABLE"
    },
    {
      "from": "UNSTABLE",
      "event": "snd Change L",
      "action": "",
      "to": "CHANGING"
    },
    {
      "from": "CHANGING",
      "event": "rcv Confirm R",
      "action": "accept value, snd Confirm L",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv empty Confirm R",
      "action": "revert to old value",
      "to": "STABLE"
    },
    {
      "from": "UNSTABLE",
      "event": "rcv Confirm/Change R",
      "action": "ignore",
      "to": "UNSTABLE"
    },
    {
      "from": "REQUEST",
      "event": "",
      "action": "",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "CLOSED",
      "event": "",
      "action": "snd Request",
      "to": "REQUEST"
    },
    {
      "from": "LISTEN",
      "event": "rcv Request",
      "action": "Generate Response",
      "to": "RESPOND"
    },
    {
      "from": "LISTEN",
      "event": "Init Cookie option received",
      "action": "Generate Response",
      "to": "RESPOND"
    },
    {
      "from": "REQUEST",
      "event": "snd Request",
      "action": "",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "rcv Response",
      "action": "Move to PARTOPEN",
      "to": "PARTOPEN"
    },
    {
      "from": "RESPOND",
      "event": "rcv Request",
      "action": "Send Response",
      "to": "RESPOND"
    },
    {
      "from": "RESPOND",
      "event": "rcv Ack/DataAck",
      "action": "Move to OPEN",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "snd Ack",
      "action": "",
      "to": "PARTOPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "rcv packet (not Response/Reset/Sync)",
      "action": "Move to OPEN",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "timeout >= 4MSL",
      "action": "Send Reset Aborted, Move to CLOSED",
      "to": "CLOSED"
    },
    {
      "from": "OPEN",
      "event": "server active close (snd CloseReq)",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "OPEN",
      "event": "active close or rcv CloseReq",
      "action": "snd Close",
      "to": "CLOSING"
    },
    {
      "from": "CLOSEREQ",
      "event": "rcv Close",
      "action": "Send Reset",
      "to": "CLOSED"
    },
    {
      "from": "CLOSING",
      "event": "snd Close",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSING",
      "event": "rcv Reset",
      "action": "Move to TIMEWAIT",
      "to": "TIMEWAIT"
    },
    {
      "from": "OPEN",
      "event": "client active close (snd Close)",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSEREQ",
      "event": "snd CloseReq",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "TIMEWAIT",
      "event": "2MSL timer expires",
      "action": "",
      "to": "CLOSED"
    }
  ]
}