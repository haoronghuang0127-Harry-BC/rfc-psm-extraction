{
  "states": [
    "INIT",
    "INIT-REBOOT",
    "SELECTING",
    "REQUESTING",
    "REBOOTING",
    "BOUND",
    "RENEWING",
    "REBINDING",
    "RENEW",
    "REBINDING"
  ],
  "transitions": [
    {
      "from": "INIT",
      "event": "DHCPREQUEST",
      "action": "client times out and retransmits the DHCPREQUEST message if the client receives neither a DHCPACK or a DHCPNAK message",
      "to": "INIT"
    },
    {
      "from": "INIT",
      "event": "DHCPREQUEST",
      "action": "client MAY choose to use the previously allocated network address and configuration parameters for the remainder of the unexpired lease",
      "to": "BOUND"
    },
    {
      "from": "INIT",
      "event": "DHCPDISCOVER",
      "action": "broadcasts the DHCPDISCOVER on the local hardware broadcast address to the 0xffffffff IP broadcast address and 'DHCP server' UDP port",
      "to": "SELECTING"
    },
    {
      "from": "INIT",
      "event": "DHCPNAK",
      "action": "Restart",
      "to": "INIT-REBOOT"
    },
    {
      "from": "INIT-REBOOT",
      "event": "DHCPREQUEST",
      "action": "broadcasts the DHCPREQUEST on the local hardware broadcast address to the 'DHCP server' UDP port",
      "to": "SELECTING"
    },
    {
      "from": "SELECTING",
      "event": "DHCPOFFER",
      "action": "Collect replies",
      "to": "REQUESTING"
    },
    {
      "from": "SELECTING",
      "event": "DHCPNAK",
      "action": "Discard offer",
      "to": "INIT-REBOOT"
    },
    {
      "from": "REQUESTING",
      "event": "DHCPREQUEST",
      "action": "send DHCPREQUEST",
      "to": "REBOOTING"
    },
    {
      "from": "REQUESTING",
      "event": "DHCPACK",
      "action": "Record lease, set timers T1, T2",
      "to": "BOUND"
    },
    {
      "from": "REQUESTING",
      "event": "DHCPNAK",
      "action": "Lease expired",
      "to": "INIT"
    },
    {
      "from": "REBOOTING",
      "event": "DHCPACK",
      "action": "Record lease, set timers T1, T2",
      "to": "BOUND"
    },
    {
      "from": "REBOOTING",
      "event": "DHCPNAK",
      "action": "Halt network",
      "to": "INIT"
    },
    {
      "from": "BOUND",
      "event": "T1 expires",
      "action": "Send DHCPREQUEST to leasing server",
      "to": "RENEWING"
    },
    {
      "from": "BOUND",
      "event": "T2 expires",
      "action": "Broadcast DHCPREQUEST",
      "to": "REBINDING"
    },
    {
      "from": "RENEWING",
      "event": "DHCPACK",
      "action": "Record lease, set timers T1, T2",
      "to": "BOUND"
    },
    {
      "from": "RENEWING",
      "event": "DHCPNAK",
      "action": "Halt network",
      "to": "INIT"
    },
    {
      "from": "REBINDING",
      "event": "DHCPACK",
      "action": "Record lease, set timers T1, T2",
      "to": "BOUND"
    },
    {
      "from": "REBINDING",
      "event": "DHCPNAK",
      "action": "Halt network",
      "to": "INIT"
    }
  ]
}