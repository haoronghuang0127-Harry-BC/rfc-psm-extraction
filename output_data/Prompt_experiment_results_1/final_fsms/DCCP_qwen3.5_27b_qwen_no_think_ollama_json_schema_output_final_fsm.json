{
  "states": [
    "CLOSED",
    "LISTEN",
    "REQUEST",
    "RESPOND",
    "PARTOPEN",
    "OPEN",
    "CLOSEREQ",
    "CLOSING",
    "TIMEWAIT",
    "STABLE",
    "CHANGING",
    "UNSTABLE",
    "Bidirectional",
    "Unidirectional",
    "ECN Incapable",
    "Connection Closed"
  ],
  "transitions": [
    {
      "from": "CLOSED",
      "event": "send DCCP-Request",
      "action": "",
      "to": "REQUEST"
    },
    {
      "from": "LISTEN",
      "event": "receive DCCP-Request",
      "action": "send DCCP-Response",
      "to": "RESPOND"
    },
    {
      "from": "REQUEST",
      "event": "receive DCCP-Response",
      "action": "",
      "to": "PARTOPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "send DCCP-Ack or DCCP-DataAck",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "receive DCCP-Ack or DCCP-DataAck",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "OPEN",
      "event": "send DCCP-CloseReq",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "OPEN",
      "event": "send DCCP-Close",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSEREQ",
      "event": "receive DCCP-Close",
      "action": "send DCCP-Reset",
      "to": "CLOSED"
    },
    {
      "from": "CLOSING",
      "event": "receive DCCP-Reset",
      "action": "",
      "to": "TIMEWAIT"
    },
    {
      "from": "STABLE",
      "event": "snd Change L",
      "action": "",
      "to": "CHANGING"
    },
    {
      "from": "STABLE",
      "event": "rcv Confirm R",
      "action": "ignore",
      "to": "STABLE"
    },
    {
      "from": "STABLE",
      "event": "rcv Change R",
      "action": "calc new value, snd Confirm L",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv Confirm R",
      "action": "accept value",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv empty Confirm R",
      "action": "revert to old value",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "pref list changes",
      "action": "",
      "to": "UNSTABLE"
    },
    {
      "from": "CHANGING",
      "event": "timeout/rcv non-ack",
      "action": "snd Change L",
      "to": "CHANGING"
    },
    {
      "from": "UNSTABLE",
      "event": "snd Change L",
      "action": "",
      "to": "CHANGING"
    },
    {
      "from": "UNSTABLE",
      "event": "rcv Confirm/Change R",
      "action": "ignore",
      "to": "UNSTABLE"
    },
    {
      "from": "REQUEST",
      "event": "receive sequence-valid DCCP-Sync",
      "action": "respond with DCCP-Reset",
      "to": "REQUEST"
    },
    {
      "from": "CLOSED",
      "event": "receive DCCP-Data packet",
      "action": "generate DCCP-Sync in response to bad reset",
      "to": "CLOSED"
    },
    {
      "from": "CLOSED",
      "event": "passive open",
      "action": "",
      "to": "LISTEN"
    },
    {
      "from": "CLOSED",
      "event": "active open",
      "action": "send DCCP-Request",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "receive DCCP-Response",
      "action": "send DCCP-Ack or DCCP-DataAck",
      "to": "PARTOPEN"
    },
    {
      "from": "RESPOND",
      "event": "receive valid DCCP-Ack",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "timeout (not less than 4MSL)",
      "action": "send DCCP-Reset with Reset Code 2",
      "to": "CLOSED"
    },
    {
      "from": "PARTOPEN",
      "event": "receive valid packet other than DCCP-Response, DCCP-Reset, or DCCP-Sync",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "timeout (more than 4MSL)",
      "action": "send DCCP-Reset with Reset Code 2",
      "to": "CLOSED"
    },
    {
      "from": "OPEN",
      "event": "server decides to close",
      "action": "send DCCP-CloseReq",
      "to": "CLOSEREQ"
    },
    {
      "from": "OPEN",
      "event": "client decides to close or receive DCCP-CloseReq",
      "action": "send DCCP-Close",
      "to": "CLOSING"
    },
    {
      "from": "OPEN",
      "event": "receive DCCP-Close",
      "action": "send DCCP-Reset",
      "to": "CLOSED"
    },
    {
      "from": "CLOSEREQ",
      "event": "retransmit DCCP-CloseReq",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "CLOSING",
      "event": "retransmit DCCP-Close",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "TIMEWAIT",
      "event": "2MSL timer expires",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "Bidirectional",
      "event": "DCCP B goes quiescent",
      "action": "",
      "to": "Unidirectional"
    },
    {
      "from": "Unidirectional",
      "event": "receive DCCP-Data or DCCP-DataAck packet from DCCP B",
      "action": "",
      "to": "Bidirectional"
    },
    {
      "from": "ECN Incapable",
      "event": "Confirm R(ECN Incapable, 1)",
      "action": "",
      "to": "ECN Incapable"
    },
    {
      "from": "ECN Incapable",
      "event": "connection closes",
      "action": "",
      "to": "Connection Closed"
    }
  ]
}