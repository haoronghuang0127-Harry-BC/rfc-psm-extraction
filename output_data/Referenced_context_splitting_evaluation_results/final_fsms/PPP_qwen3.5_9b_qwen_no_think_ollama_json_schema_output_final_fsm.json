{
  "states": [
    "Link Dead",
    "Link Establishment",
    "Opened",
    "Authenticate",
    "Network-Layer Protocol",
    "Closing",
    "Terminate",
    "DOWN",
    "Initial",
    "Starting",
    "Closed",
    "Stopped",
    "Stopping",
    "Request-Sent",
    "Ack-Received",
    "Ack-Sent"
  ],
  "transitions": [
    {
      "from": "Link Dead",
      "event": "",
      "action": "physical-layer ready",
      "to": "Link Establishment"
    },
    {
      "from": "Link Establishment",
      "event": "Configure-Ack sent and received",
      "action": "LCP Opened state entered",
      "to": "Opened"
    },
    {
      "from": "Opened",
      "event": "",
      "action": "Authentication required",
      "to": "Authenticate"
    },
    {
      "from": "Opened",
      "event": "",
      "action": "Network-layer protocols configured",
      "to": "Network-Layer Protocol"
    },
    {
      "from": "Authenticate",
      "event": "",
      "action": "Authentication completed",
      "to": "Network-Layer Protocol"
    },
    {
      "from": "Authenticate",
      "event": "authentication fails",
      "action": "proceed to Link Termination phase",
      "to": "Terminate"
    },
    {
      "from": "Network-Layer Protocol",
      "event": "LCP Configure-Request received",
      "action": "",
      "to": "Link Establishment"
    },
    {
      "from": "Network-Layer Protocol",
      "event": "",
      "action": "link closing initiated",
      "to": "Closing"
    },
    {
      "from": "Closing",
      "event": "",
      "action": "Terminate packets exchanged",
      "to": "Terminate"
    },
    {
      "from": "Terminate",
      "event": "",
      "action": "physical-layer disconnect signaled",
      "to": "DOWN"
    },
    {
      "from": "DOWN",
      "event": "external event (e.g., disconnection)",
      "action": "return to Link Dead phase",
      "to": "Link Dead"
    },
    {
      "from": "Initial",
      "event": "",
      "action": "",
      "to": "Starting"
    },
    {
      "from": "Starting",
      "event": "lower layer becomes available (Up)",
      "action": "Configure-Request is sent",
      "to": "Request-Sent"
    },
    {
      "from": "Closed",
      "event": "reception of Configure-Request packets",
      "action": "Terminate-Ack is sent",
      "to": "Stopped"
    },
    {
      "from": "Stopped",
      "event": "Configure-Request packets",
      "action": "appropriate response is sent",
      "to": "Ack-Sent"
    },
    {
      "from": "Stopped",
      "event": "other packets",
      "action": "Terminate-Ack is sent",
      "to": "Closed"
    },
    {
      "from": "Closing",
      "event": "reception of Terminate-Ack",
      "action": "",
      "to": "Closed"
    },
    {
      "from": "Closing",
      "event": "Restart timer expiration",
      "action": "new Terminate-Request is transmitted, Restart timer restarted",
      "to": "Closing"
    },
    {
      "from": "Closing",
      "event": "Restart timer expired Max-Terminate times",
      "action": "",
      "to": "Closed"
    },
    {
      "from": "Stopping",
      "event": "Terminate-Request sent, Restart timer running, Terminate-Ack not received",
      "action": "",
      "to": "Stopped"
    },
    {
      "from": "Request-Sent",
      "event": "Configure-Ack received",
      "action": "",
      "to": "Ack-Received"
    },
    {
      "from": "Request-Sent",
      "event": "Configure-Ack sent",
      "action": "",
      "to": "Ack-Sent"
    },
    {
      "from": "Ack-Received",
      "event": "Configure-Ack sent",
      "action": "",
      "to": "Ack-Sent"
    },
    {
      "from": "Ack-Sent",
      "event": "Configure-Ack received",
      "action": "",
      "to": "Opened"
    }
  ]
}