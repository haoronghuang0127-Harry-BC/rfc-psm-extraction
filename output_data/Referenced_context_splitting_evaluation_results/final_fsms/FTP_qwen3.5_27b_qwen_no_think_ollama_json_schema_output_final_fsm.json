{
  "states": [
    "Control Connection Open",
    "Data Connection Listening (Passive)",
    "Data Connection Established",
    "Control connection opened",
    "Login sequence",
    "File transfer in progress",
    "Intermediate State",
    "Connection Establishment",
    "Login",
