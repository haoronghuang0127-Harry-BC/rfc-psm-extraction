{
  "states": [
    "Initial State",
    "Mail Transaction in Progress",
    "initial state",
    "mail transaction in progress",
    "No mail transaction in progress",
    "Session without mail transaction",
    "Mail transaction",
    "Connection Established",
    "Data Input Mode"
  ],
  "transitions": [
    {
      "from": "Initial State",
      "event": "EHLO",
      "action": "clear all buffers and reset the state",
      "to": "Initial State"
    },
    {
      "from": "Initial State",
      "event": "RSET",
      "action": "discard stored sender, recipients, and mail data; clear all buffers and state tables",
      "to": "Initial State"
    },
    {
      "from": "Initial State",
      "event": "MAIL",
      "action": "clear reverse-path buffer, forward-path buffer, and mail data buffer; insert reverse-path information",
      "to": "Mail Transaction in Progress"
    },
    {
      "from": "Mail Transaction in Progress",
      "event": "RSET",
      "action": "discard stored sender, recipients, and mail data; clear all buffers and state tables",
      "to": "Initial State"
    },
    {
      "from": "Mail Transaction in Progress",
      "event": "EHLO",
      "action": "clear all buffers and reset the state",
      "to": "Initial State"
    },
    {
      "from": "Mail Transaction in Progress",
      "event": "QUIT",
      "action": "abort current uncompleted mail transaction",
      "to": "Initial State"
    },
    {
      "from": "initial state",
      "event": "EHLO",
      "action": "250 OK reply; confirm initial state; clear state tables and buffers",
      "to": "initial state"
    },
    {
      "from": "initial state",
      "event": "HELO",
      "action": "reply properly; confirm initial state; clear state tables and buffers",
      "to": "initial state"
    },
    {
      "from": "initial state",
      "event": "RSET",
      "action": "250 OK reply; discard stored sender, recipients, and mail data; clear all buffers and state tables",
      "to": "initial state"
    },
    {
      "from": "initial state",
      "event": "MAIL",
      "action": "clear reverse-path buffer, forward-path buffer, and mail data buffer; insert reverse-path information into reverse-path buffer",
      "to": "mail transaction in progress"
    },
    {
      "from": "mail transaction in progress",
      "event": "RSET",
      "action": "250 OK reply; discard stored sender, recipients, and mail data; clear all buffers and state tables",
      "to": "initial state"
    },
    {
      "from": "mail transaction in progress",
      "event": "EHLO",
      "action": "clear all buffers and reset the state exactly as if a RSET command had been issued",
      "to": "initial state"
    },
    {
      "from": "mail transaction in progress",
      "event": "QUIT",
      "action": "221 OK reply; close transmission channel; abort current uncompleted mail transaction",
      "to": "initial state"
    },
    {
      "from": "mail transaction in progress",
      "event": "DATA",
      "action": "append mail data to mail data buffer; process stored mail transaction information on end of mail data indication; clear buffers",
      "to": "initial state"
    },
    {
      "from": "initial state",
      "event": "connection opening",
      "action": "server responds with an opening message (220 or 554)",
      "to": "initial state"
    },
    {
      "from": "No mail transaction in progress",
      "event": "MAIL FROM:<reverse-path>",
      "action": "reset all state tables and buffers; return 250 OK or failure reply",
      "to": "Mail transaction in progress"
    },
    {
      "from": "Mail transaction in progress",
      "event": "RCPT TO:<forward-path>",
      "action": "store forward-path; return 250 OK or 550 reply",
      "to": "Mail transaction in progress"
    },
    {
      "from": "Mail transaction in progress",
      "event": "DATA",
      "action": "return 354 Intermediate reply",
      "to": "Mail transaction in progress"
    },
    {
      "from": "Mail transaction in progress",
      "event": "<CRLF>.<CRLF>",
      "action": "process stored recipients and mail data; return 250 OK or failure reply",
      "to": "No mail transaction in progress"
    },
    {
      "from": "Mail transaction in progress",
      "event": "RCPT TO:<forward-path> without previous MAIL",
      "action": "return 503 Bad sequence of commands",
      "to": "Mail transaction in progress"
    },
    {
      "from": "mail transaction in progress",
      "event": "DATA",
      "action": "354 response; append mail data to mail data buffer; process stored mail transaction information on end of mail data indication; clear buffers",
      "to": "initial state"
    },
    {
      "from": "Session without mail transaction",
      "event": "EHLO",
      "action": "clear all buffers and reset the state exactly as if a RSET command had been issued",
      "to": "Session without mail transaction"
    },
    {
      "from": "Session without mail transaction",
      "event": "EHLO (unacceptable)",
      "action": "return 501, 500, 502, or 550 failure replies; stay in the same state",
      "to": "Session without mail transaction"
    },
    {
      "from": "Session without mail transaction",
      "event": "MAIL",
      "action": "",
      "to": "Mail transaction"
    },
