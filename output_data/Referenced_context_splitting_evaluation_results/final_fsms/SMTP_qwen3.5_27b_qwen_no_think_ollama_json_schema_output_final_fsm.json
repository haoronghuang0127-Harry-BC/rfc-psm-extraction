      "action": "",
      "to": "Mail transaction"
    },
    {
      "from": "Mail transaction",
      "event": "RSET",
      "action": "abort the mail transaction",
      "to": "Session without mail transaction"
    },
    {
      "from": "Mail transaction",
      "event": "EHLO",
      "action": "abort the mail transaction; clear all buffers and reset the state exactly as if a RSET command had been issued",
      "to": "Session without mail transaction"
    },
    {
      "from": "Mail transaction",
      "event": "QUIT",
      "action": "abort the mail transaction",
      "to": "Session without mail transaction"
    },
    {
      "from": "Mail transaction",
      "event": "MAIL (or SEND, SOML, SAML)",
      "action": "",
      "to": "Mail transaction"
    },
    {
      "from": "Connection Established",
