    },
    {
      "from": "Not Authenticated",
      "event": "PREAUTH response",
      "action": "connection moves directly to authenticated state",
      "to": "Authenticated"
    },
    {
      "from": "Selected",
      "event": "SELECT or EXAMINE command on another mailbox",
      "action": "CLOSED response code returned, previously selected mailbox closed implicitly",
      "to": "Selected"
    },
    {
      "from": "authenticated state",
      "event": "AUTHENTICATE command",
      "action": "OK - authenticate completed",
      "to": "authenticated state"
    },
    {
      "from": "authenticated state",
      "event": "LOGIN command",
      "action": "OK - login completed",
      "to": "authenticated state"
    },
    {
      "from": "selected state",
      "event": "CLOSE command",
      "action": "OK - close completed",
      "to": "authenticated state"
    },
    {
      "from": "selected state",
      "event": "UNSELECT command",
      "action": "OK - unselect completed",
      "to": "authenticated state"
    },
    {
      "from": "authenticated state",
      "event": "SELECT command",
      "action": "OK - select completed",
      "to": "selected state"
    },
    {
      "from": "authenticated state",
      "event": "EXAMINE command",
      "action": "OK - examine completed",
      "to": "selected state"
