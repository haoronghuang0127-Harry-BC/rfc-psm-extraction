    },
    {
      "from": "Authenticated",
      "event": "UNSUBSCRIBE",
      "action": "BAD - command unknown or arguments invalid",
      "to": "Authenticated"
    },
    {
      "from": "Authenticated State",
      "event": "NAMESPACE",
      "action": "OK - command completed; NO - Can't complete the command; BAD - arguments invalid; untagged NAMESPACE response",
