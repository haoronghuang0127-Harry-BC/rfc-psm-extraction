    },
    {
      "from": "Authenticated State",
      "event": "APPEND",
      "action": "BAD - command unknown or arguments invalid",
      "to": "Authenticated State"
    },
    {
      "from": "Authenticated State",
      "event": "IDLE",
      "action": "+ idling",
      "to": "IDLE"
    },
    {
      "from": "IDLE",
      "event": "DONE",
      "action": "OK - IDLE completed after client sent DONE",
      "to": "Authenticated State"
    },
    {
      "from": "selected",
      "event": "CLOSE",
      "action": "OK - close completed, now in authenticated state",
      "to": "authenticated"
    },
    {
      "from": "selected",
      "event": "CLOSE",
      "action": "BAD - command unknown or arguments invalid",
      "to": "selected"
    },
    {
      "from": "Selected State",
      "event": "UNSELECT",
      "action": "OK - unselect completed, now in authenticated state",
