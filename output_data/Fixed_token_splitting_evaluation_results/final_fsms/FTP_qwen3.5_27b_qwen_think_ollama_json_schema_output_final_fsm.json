      "from": "User Session Active",
      "event": "REIN",
      "action": "Terminates USER, flushes I/O and account information, resets parameters",
      "to": "Control Connection Opened"
    },
    {
      "from": "User Session Active",
      "event": "QUIT",
      "action": "Terminates USER, closes control connection",
      "to": "Connection Closed"
    },
    {
      "from": "File Transfer In Progress",
      "event": "QUIT",
      "action": "Remains open for result response then closes control connection",
      "to": "Connection Closed"
    },
    {
      "from": "User Session Active",
      "event": "RETR / STOR / APPE / LIST / NLST",
      "action": "Data transfer starts over data connection",
      "to": "File Transfer In Progress"
    },
    {
      "from": "File Transfer In Progress",
      "event": "ABOR",
      "action": "Aborts FTP service command, closes data connection",
      "to": "User Session Active"
