{
  "states": [
    "idle",
    "wait_ctl_reply",
    "established",
    "wait_stop_reply",
    "wait_reply",
    "wait_cs_ans",
    "Wait-Reply",
    "Established",
    "Wait-Disconnect"
  ],
  "transitions": [
    {
      "from": "idle",
      "event": "",
      "action": "TCP Open Indication /Send Start Control Connection Request",
      "to": "wait_ctl_reply"
    },
    {
      "from": "idle",
      "event": "Collision/See (4.1.3)",
      "action": "Close TCP",
      "to": "idle"
    },
    {
      "from": "wait_ctl_reply",
      "event": "Receive Start Ctl Connection Reply Version OK",
      "action": "",
      "to": "established"
    },
    {
      "from": "wait_ctl_reply",
      "event": "Receive Start Ctl Connection Reply Version Not OK/Send Stop Control Request",
      "action": "Send Stop Control Request",
      "to": "wait_stop_reply"
    },
    {
      "from": "established",
      "event": "Local Terminate /Send Stop Control Request",
      "action": "Send Stop-Control-Connection-Request",
      "to": "wait_stop_reply"
    },
    {
      "from": "established",
      "event": "Receive Stop-Control-Connection-Request",
      "action": "Send Stop-Control-Connection-Reply /Close TCP",
      "to": "idle"
    },
    {
      "from": "wait_stop_reply",
      "event": "Receive Stop-Control-Connection-Reply",
      "action": "Close TCP",
      "to": "idle"
    },
    {
      "from": "idle",
      "event": "",
      "action": "detect incoming call; send Incoming-Call-Request",
      "to": "wait_reply"
    },
    {
      "from": "wait_reply",
      "event": "Receive Incoming Call Reply Accepting/Answer call",
      "action": "Send Incoming-Call-Connected",
      "to": "established"
    },
    {
      "from": "wait_reply",
      "event": "Receive Incoming Call Reply Not Accepting",
      "action": "",
      "to": "idle"
    },
    {
      "from": "idle",
      "event": "Receive Clear Call Request or telco call dropped or local disconnect",
      "action": "Send Call Disconnect Notify",
      "to": "idle"
    },
    {
      "from": "established",
      "event": "Receive Call-Clear-Request",
      "action": "Release telco call; Send Call-Disconnect-Notify",
      "to": "idle"
    },
    {
      "from": "established",
      "event": "telco disconnect or local reason",
      "action": "Send Call-Disconnect-Notify",
      "to": "idle"
    },
    {
      "from": "idle",
      "event": "Receive Outgoing Call Request No Error",
      "action": "Off Hook; Dial",
      "to": "wait_cs_ans"
    },
    {
      "from": "wait_cs_ans",
      "event": "Telco Answer",
      "action": "Send Outgoing Call Reply",
      "to": "established"
    },
    {
      "from": "wait_cs_ans",
      "event": "Incomplete Call or timer expires",
      "action": "Send Outgoing Call Reply with Error",
      "to": "idle"
    },
    {
      "from": "wait_cs_ans",
      "event": "Recv. Call Clear Req.",
      "action": "Send Disconnect Notify",
      "to": "idle"
    },
    {
      "from": "established",
      "event": "Receive Call Clear Request or local terminate or telco disconnect",
      "action": "Hangup call and send Call Disconnect Notify",
      "to": "idle"
    },
    {
      "from": "idle",
      "event": "",
      "action": "Send Outgoing Call Request",
      "to": "Wait-Reply"
    },
    {
      "from": "Wait-Reply",
      "event": "Receive Outgoing Call Reply with Error",
      "action": "",
      "to": "idle"
    },
    {
      "from": "Wait-Reply",
      "event": "Receive Outgoing Call Reply No Error",
      "action": "",
      "to": "Established"
    },
    {
      "from": "Established",
      "event": "Receive Call Disconnect Notify",
      "action": "",
      "to": "idle"
    },
    {
      "from": "Established",
      "event": "Local Terminate",
      "action": "Send Call Clear Request",
      "to": "Wait-Disconnect"
    },
    {
      "from": "Wait-Disconnect",
      "event": "Receive Call Disconnect Notify",
      "action": "",
      "to": "idle"
    }
  ]
}