  "transitions": [
    {
      "from": "Connection",
      "event": "",
      "action": "initial greeting from the server",
      "to": "Session"
    },
    {
      "from": "Not Authenticated State",
      "event": "successful LOGIN or AUTHENTICATE command",
      "action": "",
      "to": "Authenticated State"
    },
    {
      "from": "Authenticated State",
      "event": "successful SELECT or EXAMINE command",
      "action": "",
      "to": "Selected State"
    },
    {
      "from": "Authenticated State",
      "event": "CLOSE or UNSELECT command, unsolicited CLOSED response code, or failed SELECT or EXAMINE command",
      "action": "",
      "to": "Not Authenticated State"
    },
    {
      "from": "Selected State",
      "event": "LOGOUT command",
      "action": "send an untagged BYE response and a tagged OK response to the LOGOUT command",
      "to": "Logout State"
    },
    {
      "from": "Selected State",
      "event": "server shutdown, or connection closed",
      "action": "",
      "to": "Logout State"
    },
    {
      "from": "Logout State",
      "event": "both sides close the connection",
      "action": "",
      "to": "Logout State"
    },
    {
      "from": "Any State",
      "event": "CAPABILITY",
      "action": "OK",
      "to": "Any State"
    },
    {
      "from": "Any State",
      "event": "NOOP",
      "action": "OK",
      "to": "Any State"
    },
    {
      "from": "Any State",
