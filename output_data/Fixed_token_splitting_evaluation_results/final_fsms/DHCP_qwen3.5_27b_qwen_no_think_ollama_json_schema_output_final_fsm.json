      "event": "DHCPNAK",
      "action": "request a new address by restarting the configuration process",
      "to": "INIT"
    },
    {
      "from": "BOUND",
      "event": "timeout after retransmission algorithm",
      "action": "choose to use the previously allocated network address and configuration parameters for the remainder of the unexpired lease",
