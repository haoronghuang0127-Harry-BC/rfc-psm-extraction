{
  "states": [
    "AUTHORIZATION",
    "TRANSACTION",
    "UPDATE"
  ],
  "transitions": [
    {
      "from": "AUTHORIZATION",
      "event": "successful authentication",
      "action": "server acquires resources associated with the client's maildrop",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "QUIT",
      "action": "session terminates",
      "to": "UPDATE"
    },
    {
      "from": "TRANSACTION",
      "event": "QUIT",
      "action": "server releases any resources acquired during the TRANSACTION state and says goodbye; TCP connection is then closed",
      "to": "UPDATE"
    },
    {
      "from": "AUTHORIZATION",
      "event": "PASS",
      "action": "+OK maildrop locked and ready",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "APOP",
      "action": "+OK maildrop locked and ready",
      "to": "TRANSACTION"
    }
  ]
}