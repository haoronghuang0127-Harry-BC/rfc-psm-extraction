    {
      "from": "authz-info",
      "event": "Client connects to Broker",
      "action": "use TLS:Anon,MQTT:None",
      "to": "Client connects to Broker"
    },
    {
      "from": "Connected",
      "event": "PUBLISH packet with QoS >= 1",
      "action": "return PUBACK or PUBREC with reason code 0x87",
      "to": "Unauthorized"
    },
    {
      "from": "Connected",
      "event": "PUBLISH packet with QoS 0",
      "action": "send DISCONNECT packet with reason code 0x87 and close connection",
      "to": "Unauthorized"
    },
    {
      "from": "Connected",
      "event": "SUBSCRIBE packet",
      "action": "match Topic Filter against scope; return SUBACK with 0x87 for unauthorized filters",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "Token expiration",
      "action": "send PUBACK, SUBACK, or DISCONNECT with 'Not authorized'",
      "to": "Unauthorized"
    },
    {
      "from": "Connected",
      "event": "PINGREQ packet",
      "action": "check for token expiration",
      "to": "Connected"
    },
    {
      "from": "Unauthorized",
      "event": "Reauthentication request (AUTH packet)",
      "action": "accept if PoP validated, otherwise deny",
      "to": "Connected"
    },
    {
      "from": "Unauthorized",
      "event": "Reauthentication request (AUTH packet)",
      "action": "deny",
      "to": "Unauthorized"
    },
    {
      "from": "New Session",
      "event": "CONNACK",
      "action": "signal new Session to Client",
      "to": "Connected"
    },
    {
      "from": "Existing Session",
      "event": "CONNACK",
      "action": "signal continued Session to Client",
      "to": "Connected"
    }
  ]
