      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "rcv Ack/DataAck",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "timeout",
      "action": "Generate Reset(Aborted)",
      "to": "CLOSED"
    },
    {
      "from": "RESPOND",
      "event": "P.type == Request",
      "action": "Send Response, possibly containing Init Cookie",
      "to": "RESPOND"
    },
    {
      "from": "RESPOND",
      "event": "P.type == Request",
      "action": "Destroy S",
      "to": "RESPOND"
    },
    {
      "from": "RESPOND",
      "event": "P.type != Request",
      "action": "S.OSR := P.seqno S.state := OPEN",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
