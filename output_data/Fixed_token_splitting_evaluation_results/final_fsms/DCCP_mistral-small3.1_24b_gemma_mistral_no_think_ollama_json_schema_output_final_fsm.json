      "action": "Set S := new socket for this port pair, S.state = RESPOND, Choose S.ISS, Initialize S.GAR := S.ISS, Set S.ISR, S.GSR, S.SWL, S.SWH from packet or Init Cookies",
      "to": "RESPOND"
    },
    {
      "from": "LISTEN",
      "event": "rcv packet",
      "action": "Generate Reset(No Connection) unless P.type == Reset",
      "to": "CLOSED"
    },
    {
      "from": "REQUEST",
      "event": "DCCP-Response",
      "action": "",
      "to": "PARTOPEN"
    },
    {
      "from": "REQUEST",
      "event": "DCCP-Sync",
      "action": "DCCP-Reset",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Reset",
      "action": "Generate Reset(Packet Error) Drop packet",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Sync or P.type == SyncAck",
      "action": "Update S.GSR, S.SWL, S.SWH",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Sync or P.type == SyncAck",
      "action": "Drop packet",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == CloseReq or P.type == Close or P.type == Reset",
      "action": "Drop packet",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Reset",
      "action": "Send Sync packet acknowledging S.GSR",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type != Reset",
      "action": "Send Sync packet acknowledging P.seqno",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == CloseReq",
      "action": "Send Sync packet acknowledging P.seqno",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Response",
      "action": "Send Sync packet acknowledging P.seqno",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Request",
      "action": "Send Sync packet acknowledging P.seqno",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Request and P.seqno >= S.OSR",
      "action": "Send Sync packet acknowledging P.seqno",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Response and P.seqno >= S.OSR",
      "action": "Send Sync packet acknowledging P.seqno",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Data",
      "action": "Send Sync packet acknowledging P.seqno",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "",
      "action": "Mark packet as acknowledgeable",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Reset",
      "action": "Tear down connection S.state := TIMEWAIT Set TIMEWAIT timer Drop packet",
      "to": "TIMEWAIT"
    },
    {
      "from": "REQUEST",
      "event": "",
      "action": "S.state := PARTOPEN Set PARTOPEN timer",
      "to": "PARTOPEN"
    },
    {
      "from": "REQUEST",
      "event": "rcv Response",
      "action": "Set S.GSR, S.ISR, S.SWL, S.SWH",
