    },
    {
      "from": "AUTHORIZATION",
      "event": "APOP name digest",
      "action": "+OK maildrop locked and ready",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "APOP name digest",
      "action": "-ERR permission denied",
      "to": "AUTHORIZATION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "PASS string",
      "action": "+OK maildrop locked and ready",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "PASS string",
      "action": "-ERR invalid password",
