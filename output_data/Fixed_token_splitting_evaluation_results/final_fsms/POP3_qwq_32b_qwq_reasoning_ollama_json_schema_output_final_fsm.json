{
  "states": [
    "AUTHORIZATION",
    "TRANSACTION",
    "UPDATE"
  ],
  "transitions": [
    {
      "from": "AUTHORIZATION",
      "event": "USER/PASS or APOP",
      "action": "authenticate successfully",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "QUIT",
      "action": "close connection",
      "to": "UPDATE"
    },
    {
      "from": "TRANSACTION",
      "event": "QUIT",
      "action": "enter UPDATE state",
      "to": "UPDATE"
    },
    {
      "from": "TRANSACTION",
      "event": "RSET",
      "action": "unmark deleted messages",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "DELE",
      "action": "mark message as deleted",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "NOOP",
      "action": "",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "STAT",
      "action": "",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "LIST",
      "action": "",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "RETR",
      "action": "",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "TOP",
      "action": "",
      "to": "TRANSACTION"
    },
    {
      "from": "TRANSACTION",
      "event": "UIDL",
      "action": "",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "PASS",
      "action": "may only be given after successful USER command",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "APOP",
      "action": "valid in AUTHORIZATION state",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "USER",
      "action": "successful USER command",
      "to": "AUTHORIZATION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "QUIT",
      "action": "",
      "to": "closed"
    },
    {
      "from": "TRANSACTION",
      "event": "QUIT",
      "action": "",
      "to": "closed"
    }
  ]
}