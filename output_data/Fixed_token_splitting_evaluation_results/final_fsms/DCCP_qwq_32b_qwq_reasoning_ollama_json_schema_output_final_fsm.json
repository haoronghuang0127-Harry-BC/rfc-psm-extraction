{
  "states": [
    "CLOSED",
    "LISTEN",
    "REQUEST",
    "RESPOND",
    "PARTOPEN",
    "OPEN",
    "CLOSEREQ",
    "CLOSING",
    "TIMEWAIT",
    "ESTABLISHED",
    "STABLE",
    "CHANGING",
    "UNSTABLE",
    "State 0",
    "State 1",
    "State 3",
    "0/1"
  ],
  "transitions": [
    {
      "from": "CLOSED",
      "event": "DCCP-Request sent",
      "action": "",
      "to": "REQUEST"
    },
    {
      "from": "LISTEN",
      "event": "DCCP-Request received",
      "action": "",
      "to": "RESPOND"
    },
    {
      "from": "REQUEST",
      "event": "DCCP-Response received",
      "action": "",
      "to": "PARTOPEN"
    },
    {
      "from": "RESPOND",
      "event": "DCCP-Ack or DCCP-DataAck received",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "DCCP-Ack or DCCP-DataAck received",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "OPEN",
      "event": "DCCP-CloseReq received",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "OPEN",
      "event": "DCCP-Close sent/received",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSEREQ",
      "event": "DCCP-Close sent",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSING",
      "event": "DCCP-Reset received",
      "action": "",
      "to": "TIMEWAIT"
    },
    {
      "from": "TIMEWAIT",
      "event": "2MSL timer expires",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "CLOSED",
      "event": "DCCP-Request",
      "action": "sends DCCP-Response",
      "to": "LISTEN"
    },
    {
      "from": "LISTEN",
      "event": "DCCP-Response",
      "action": "sends DCCP-Ack",
      "to": "ESTABLISHED"
    },
    {
      "from": "ESTABLISHED",
      "event": "DCCP-CloseReq",
      "action": "sends DCCP-Close",
      "to": "TIMEWAIT"
    },
    {
      "from": "ESTABLISHED",
      "event": "DCCP-Close",
      "action": "sends DCCP-Reset",
      "to": "TIMEWAIT"
    },
    {
      "from": "TIMEWAIT",
      "event": "2MSL timeout",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "STABLE",
      "event": "rcv Confirm R",
      "action": "ignore",
      "to": "STABLE"
    },
    {
      "from": "STABLE",
      "event": "app/protocol evt",
      "action": "snd Change L",
      "to": "CHANGING"
    },
    {
      "from": "STABLE",
      "event": "rcv non-ack",
      "action": "snd Change L",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv Change R",
      "action": "calc new value, snd Confirm L",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv empty Confirm R",
      "action": "revert to old value",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv Confirm R",
      "action": "if valid set F.value, set F.state := STABLE",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "pref list changes",
      "action": "transition to UNSTABLE",
      "to": "UNSTABLE"
    },
    {
      "from": "UNSTABLE",
      "event": "snd Change L",
      "action": "transition back to CHANGING",
      "to": "CHANGING"
    },
    {
      "from": "REQUEST",
      "event": "Response",
      "action": "Move to PARTOPEN state, set PARTOPEN timer",
      "to": "PARTOPEN"
    },
    {
      "from": "RESPOND",
      "event": "Request",
      "action": "Send Response, possibly with Init Cookie; destroy socket if Init Cookie sent",
      "to": "RESPOND"
    },
    {
      "from": "RESPOND",
      "event": "Other valid packet types",
      "action": "Set S.OSR to P.seqno, move to OPEN",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "Response",
      "action": "Send Ack",
      "to": "PARTOPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "P.type != Sync",
      "action": "Set S.OSR to P.seqno, move to OPEN",
      "to": "OPEN"
    },
    {
      "from": "CLOSEREQ",
      "event": "CloseReq",
      "action": "Generate Close, move to CLOSING",
      "to": "CLOSING"
    },
    {
      "from": "State 0",
