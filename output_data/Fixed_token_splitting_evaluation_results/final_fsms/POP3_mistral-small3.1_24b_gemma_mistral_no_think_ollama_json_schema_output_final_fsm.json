{
  "states": [
    "AUTHORIZATION",
    "TRANSACTION",
    "UPDATE"
  ],
  "transitions": [
    {
      "from": "AUTHORIZATION",
      "event": "USER and PASS command combination or APOP command",
      "action": "acquires an exclusive-access lock on the maildrop",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "QUIT",
      "action": "+OK",
      "to": "AUTHORIZATION"
    },
    {
      "from": "TRANSACTION",
      "event": "QUIT",
      "action": "removes all messages marked as deleted from the maildrop",
      "to": "UPDATE"
    },
    {
      "from": "TRANSACTION",
      "event": "inactivity autologout timer",
      "action": "closes the TCP connection without removing any messages or sending any response to the client",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "PASS string",
      "action": "+OK maildrop locked and ready",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "PASS string",
      "action": "-ERR invalid password",
      "to": "AUTHORIZATION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "PASS string",
      "action": "-ERR unable to lock maildrop",
      "to": "AUTHORIZATION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "APOP name digest",
      "action": "+OK maildrop locked and ready",
      "to": "TRANSACTION"
    },
    {
      "from": "AUTHORIZATION",
      "event": "APOP name digest",
      "action": "-ERR permission denied",
      "to": "AUTHORIZATION"
    }
  ]
}