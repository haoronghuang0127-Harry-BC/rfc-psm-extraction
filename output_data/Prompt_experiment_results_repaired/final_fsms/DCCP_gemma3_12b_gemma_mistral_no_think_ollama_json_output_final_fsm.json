{
  "states": [
    "client",
    "server",
    "CLOSED",
    "LISTEN",
    "REQUEST",
    "RESPOND",
    "PARTOPEN",
    "OPEN",
    "CLOSEREQ",
    "CLOSING",
    "TIMEWAIT",
    "STABLE",
    "CHANGING",
    "UNSTABLE",
    "ECN Capable",
    "ECN Incapable"
  ],
  "transitions": [
    {
      "from": "client",
      "event": "",
      "action": "actively initiated",
      "to": "server"
    },
    {
      "from": "CLOSED",
      "event": "",
      "action": "",
      "to": "LISTEN"
    },
    {
      "from": "LISTEN",
      "event": "DCCP-Request",
      "action": "",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "DCCP-Response",
      "action": "",
      "to": "PARTOPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "DCCP-Ack or DCCP-DataAck",
      "action": "",
      "to": "OPEN"
    },
    {
      "from": "OPEN",
      "event": "DCCP-CloseReq",
      "action": "",
      "to": "CLOSEREQ"
    },
    {
      "from": "CLOSEREQ",
      "event": "DCCP-Close",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "CLOSING",
      "event": "",
      "action": "",
      "to": "TIMEWAIT"
    },
    {
      "from": "OPEN",
      "event": "DCCP-Close",
      "action": "",
      "to": "CLOSING"
    },
    {
      "from": "STABLE",
      "event": "rcv Change R",
      "action": "calc new value, snd Confirm L",
      "to": "CHANGING"
    },
    {
      "from": "STABLE",
      "event": "rcv Confirm R",
      "action": "ignore",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv Confirm R",
      "action": "Set F.value := new value, Set F.state := STABLE",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv Confirm R",
      "action": "Reset connection and return",
      "to": "STABLE"
    },
    {
      "from": "UNSTABLE",
      "event": "pref list changes",
      "action": "transition to UNSTABLE",
      "to": "UNSTABLE"
    },
    {
      "from": "CLOSED",
      "event": "",
      "action": "snd Request",
      "to": "REQUEST"
    },
    {
      "from": "LISTEN",
      "event": "rcv Request",
      "action": "snd Response",
      "to": "RESPOND"
    },
    {
      "from": "REQUEST",
      "event": "rcv Response",
      "action": "snd Ack",
      "to": "PARTOPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "rcv packet",
      "action": "snd Ack",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "rcv Ack/DataAck",
      "action": "move to OPEN",
      "to": "OPEN"
    },
    {
      "from": "REQUEST",
      "event": "no response",
      "action": "snd DCCP-Reset",
      "to": "CLOSED"
    },
    {
      "from": "PARTOPEN",
      "event": "timeout",
      "action": "reset connection",
      "to": "CLOSED"
    },
    {
      "from": "OPEN",
      "event": "rcv CloseReq",
      "action": "snd Close",
      "to": "CLOSING"
    },
    {
      "from": "OPEN",
      "event": "rcv Close",
      "action": "snd Reset",
      "to": "CLOSED"
    },
    {
      "from": "OPEN",
      "event": "rcv Reset",
      "action": "hold TIMEWAIT state",
      "to": "TIMEWAIT"
    },
    {
      "from": "CLOSING",
      "event": "rcv Close",
      "action": "snd Reset",
      "to": "CLOSED"
    },
    {
      "from": "CLOSING",
      "event": "rcv Reset",
      "action": "hold TIMEWAIT state",
      "to": "TIMEWAIT"
    },
    {
      "from": "OPEN",
      "event": "snd CloseReq",
      "action": "snd Close",
      "to": "CLOSEREQ"
    },
    {
      "from": "ECN Capable",
      "event": "Change L(ECN Inapable, 1)",
      "action": "send option",
      "to": "ECN Incapable"
    },
    {
      "from": "ECN Incapable",
      "event": "Confirm R(ECN Incapable, 1)",
      "action": "transition to ECN Capable",
      "to": "ECN Capable"
    },
    {
      "from": "ECN Incapable",
      "event": "Data Dropped option",
      "action": "send Data Dropped option",
      "to": "ECN Incapable"
    }
  ]
}