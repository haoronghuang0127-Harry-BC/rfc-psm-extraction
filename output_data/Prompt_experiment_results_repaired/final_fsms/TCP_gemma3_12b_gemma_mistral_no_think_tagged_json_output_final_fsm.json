  "transitions": [
    {
      "from": "CLOSED",
      "event": "OPEN",
      "action": "Create a new transmission control block (TCB) to hold connection state information.",
      "to": "LISTEN"
    },
    {
      "from": "LISTEN",
      "event": "SYN",
      "action": "Set RCV.NXT to SEG.SEQ+1, IRS is set to SEG.SEQ.",
      "to": "SYN-RECEIVED"
    },
    {
      "from": "SYN-SENT",
      "event": "ACK",
      "action": "Enter ESTABLISHED state",
      "to": "ESTABLISHED"
    },
    {
      "from": "SYN-RECEIVED",
      "event": "SYN",
      "action": "Enter ESTABLISHED state",
      "to": "ESTABLISHED"
    },
    {
      "from": "ESTABLISHED",
      "event": "SEND",
      "action": "Segmentize the buffer and send it with a piggybacked acknowledgment",
      "to": "ESTABLISHED"
    },
    {
      "from": "ESTABLISHED",
      "event": "CLOSE",
      "action": "Queue this until all preceding SENDs have been segmentized; then send a FIN segment, enter FIN-WAIT-1 state.",
      "to": "FIN-WAIT-1"
    },
    {
      "from": "FIN-WAIT-1",
      "event": "FIN",
      "action": "Enter FIN-WAIT-2",
      "to": "FIN-WAIT-2"
    },
    {
      "from": "FIN-WAIT-2",
      "event": "CLOSE",
      "action": "Enter TIME-WAIT",
      "to": "TIME-WAIT"
    },
    {
      "from": "CLOSE-WAIT",
      "event": "CLOSE",
      "action": "Send a FIN segment, enter LAST-ACK state.",
      "to": "LAST-ACK"
    },
    {
      "from": "CLOSING",
      "event": "ACK",
      "action": "Enter TIME-WAIT",
      "to": "TIME-WAIT"
    },
    {
      "from": "LAST-ACK",
      "event": "",
      "action": "Delete the TCB, enter the CLOSED state, and return.",
      "to": "CLOSED"
    },
    {
      "from": "TIME-WAIT",
      "event": "",
      "action": "Delete the TCB, enter the CLOSED state, and return.",
      "to": "CLOSED"
    }
