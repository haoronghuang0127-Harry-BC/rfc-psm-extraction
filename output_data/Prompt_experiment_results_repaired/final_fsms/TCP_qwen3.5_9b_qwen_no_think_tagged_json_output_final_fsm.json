{
  "states": [
    "CLOSED",
    "LISTEN",
    "SYN-SENT",
    "SYN-RECEIVED",
    "ESTABLISHED",
    "FIN-WAIT-1",
    "FIN-WAIT-2",
    "CLOSE-WAIT",
    "CLOSING",
    "LAST-ACK",
    "TIME-WAIT"
  ],
  "transitions": [
    {
      "from": "CLOSED",
      "event": "OPEN (active)",
      "action": "create TCB, select ISS, send SYN, enter SYN-SENT",
      "to": "SYN-SENT"
    },
    {
      "from": "CLOSED",
      "event": "OPEN (passive)",
      "action": "create TCB, enter LISTEN",
      "to": "LISTEN"
    },
    {
      "from": "LISTEN",
      "event": "OPEN (active)",
      "action": "change to active, select ISS, send SYN, enter SYN-SENT",
      "to": "SYN-SENT"
    },
    {
      "from": "LISTEN",
      "event": "rcv SYN",
      "action": "set RCV.NXT, IRS, select ISS, send SYN+ACK, enter SYN-RECEIVED",
      "to": "SYN-RECEIVED"
    },
    {
      "from": "LISTEN",
      "event": "rcv ACK",
      "action": "send RST",
      "to": "LISTEN"
    },
    {
      "from": "LISTEN",
      "event": "rcv RST",
      "action": "ignore",
      "to": "LISTEN"
    },
    {
      "from": "SYN-SENT",
      "event": "rcv SYN+ACK",
      "action": "set RCV.NXT, IRS, advance SND.UNA, enter ESTABLISHED",
      "to": "ESTABLISHED"
    },
    {
      "from": "SYN-SENT",
      "event": "rcv ACK",
      "action": "send RST",
      "to": "CLOSED"
    },
    {
      "from": "SYN-SENT",
      "event": "rcv SYN",
      "action": "set RCV.NXT, IRS, enter SYN-RECEIVED",
      "to": "SYN-RECEIVED"
    },
    {
      "from": "SYN-SENT",
      "event": "rcv RST",
      "action": "signal reset, delete TCB",
      "to": "CLOSED"
    },
    {
      "from": "SYN-RECEIVED",
      "event": "rcv ACK",
      "action": "enter ESTABLISHED",
      "to": "ESTABLISHED"
    },
    {
      "from": "SYN-RECEIVED",
      "event": "rcv SYN+ACK",
      "action": "set RCV.NXT, IRS, advance SND.UNA, enter ESTABLISHED",
      "to": "ESTABLISHED"
    },
    {
      "from": "SYN-RECEIVED",
      "event": "rcv SYN",
      "action": "send SYN+ACK, enter SYN-RECEIVED",
      "to": "SYN-RECEIVED"
    },
    {
      "from": "SYN-RECEIVED",
      "event": "rcv RST",
      "action": "if passive return LISTEN; if active signal refused, delete TCB",
      "to": "LISTEN"
    },
    {
      "from": "ESTABLISHED",
      "event": "CLOSE",
      "action": "send FIN, enter FIN-WAIT-1",
      "to": "FIN-WAIT-1"
    },
    {
      "from": "ESTABLISHED",
      "event": "rcv FIN",
      "action": "enter CLOSE-WAIT",
      "to": "CLOSE-WAIT"
    },
    {
      "from": "FIN-WAIT-1",
      "event": "rcv ACK of FIN",
      "action": "enter FIN-WAIT-2",
      "to": "FIN-WAIT-2"
    },
    {
      "from": "FIN-WAIT-1",
      "event": "rcv FIN",
      "action": "if our FIN acked enter TIME-WAIT; else enter CLOSING",
      "to": "TIME-WAIT"
    },
    {
      "from": "FIN-WAIT-1",
      "event": "CLOSE",
      "action": "send FIN, enter FIN-WAIT-2",
      "to": "FIN-WAIT-2"
    },
    {
      "from": "FIN-WAIT-2",
      "event": "rcv ACK of FIN",
      "action": "delete TCB, enter CLOSED",
      "to": "CLOSED"
    },
    {
      "from": "FIN-WAIT-2",
      "event": "CLOSE",
      "action": "send FIN, enter TIME-WAIT",
      "to": "TIME-WAIT"
    },
    {
      "from": "CLOSE-WAIT",
      "event": "rcv ACK of FIN",
      "action": "enter CLOSING",
      "to": "CLOSING"
    },
    {
      "from": "CLOSE-WAIT",
      "event": "CLOSE",
      "action": "send FIN, enter LAST-ACK",
      "to": "LAST-ACK"
    },
    {
      "from": "CLOSING",
      "event": "rcv ACK of FIN",
      "action": "enter TIME-WAIT",
      "to": "TIME-WAIT"
    },
    {
      "from": "LAST-ACK",
      "event": "rcv ACK of FIN",
      "action": "delete TCB, enter CLOSED",
      "to": "CLOSED"
    },
    {
      "from": "TIME-WAIT",
      "event": "TIME-WAIT TIMEOUT",
      "action": "delete TCB",
      "to": "CLOSED"
    }
  ]
}