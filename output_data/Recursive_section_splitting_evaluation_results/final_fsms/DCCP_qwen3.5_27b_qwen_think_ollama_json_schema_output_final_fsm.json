{
  "states": [
    "CLOSED",
    "LISTEN",
    "REQUEST",
    "RESPOND",
    "PARTOPEN",
    "OPEN",
    "CLOSEREQ",
    "CLOSING",
    "TIMEWAIT",
    "STABLE",
    "CHANGING",
    "UNSTABLE",
    "bidirectional",
    "unidirectional",
    "Received",
    "Received ECN Marked",
    "Reserved",
    "Not Yet Received"
  ],
  "transitions": [
    {
      "from": "CLOSED",
      "event": "Send DCCP-Request",
      "action": "Send DCCP-Request",
      "to": "REQUEST"
    },
    {
      "from": "CLOSED",
      "event": "passive open",
      "action": "",
      "to": "LISTEN"
    },
    {
      "from": "LISTEN",
      "event": "P.type == Request or P contains a valid Init Cookie option",
      "action": "Set S := new socket, S.state = RESPOND, Choose ISS, Initialize variables",
      "to": "RESPOND"
    },
    {
      "from": "LISTEN",
      "event": "Send DCCP-Reset",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Response and S.AWL <= P.ackno <= S.AWH",
      "action": "Set sequence numbers, S.state := PARTOPEN, Set PARTOPEN timer",
      "to": "PARTOPEN"
    },
    {
      "from": "REQUEST",
      "event": "P.type == Reset",
      "action": "Tear down connection, S.state := TIMEWAIT, Set TIMEWAIT timer",
      "to": "TIMEWAIT"
    },
    {
      "from": "REQUEST",
      "event": "no response is received",
      "action": "send new DCCP-Request packets",
      "to": "REQUEST"
    },
    {
      "from": "REQUEST",
      "event": "give up on its DCCP-Requests after some time",
      "action": "send a DCCP-Reset packet with Reset Code 2, 'Aborted'",
      "to": "CLOSED"
    },
    {
      "from": "REQUEST",
      "event": "Send DCCP-Reset",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "PARTOPEN",
      "event": "Send DCCP-Ack or DCCP-DataAck",
      "action": "Send DCCP-Ack or DCCP-DataAck",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "P.type != Response and P.type != Sync",
      "action": "S.OSR := P.seqno, S.state := OPEN",
      "to": "OPEN"
    },
    {
      "from": "PARTOPEN",
      "event": "remains in PARTOPEN for more than 4MSL",
      "action": "reset the connection with Reset Code 2, 'Aborted'",
      "to": "CLOSED"
    },
    {
      "from": "RESPOND",
      "event": "P.type != Request",
      "action": "S.OSR := P.seqno, S.state := OPEN",
      "to": "OPEN"
    },
    {
      "from": "RESPOND",
      "event": "timeout of not less than 4MSL",
      "action": "send a DCCP-Reset with Reset Code 2, 'Aborted'",
      "to": "CLOSED"
    },
    {
      "from": "RESPOND",
      "event": "receives a valid DCCP-Request",
      "action": "elicit a new DCCP-Response",
      "to": "RESPOND"
    },
    {
      "from": "RESPOND",
      "event": "Send DCCP-Reset",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "OPEN",
      "event": "Send DCCP-CloseReq",
      "action": "Send DCCP-CloseReq",
      "to": "CLOSEREQ"
    },
    {
      "from": "OPEN",
      "event": "Receive DCCP-CloseReq",
      "action": "Send DCCP-Close",
      "to": "CLOSING"
    },
    {
      "from": "OPEN",
      "event": "Send DCCP-Close",
      "action": "Send DCCP-Close",
      "to": "CLOSING"
    },
    {
      "from": "OPEN",
      "event": "Receive DCCP-Reset",
      "action": "Abort",
      "to": "CLOSED"
    },
    {
      "from": "OPEN",
      "event": "P.type == Reset",
      "action": "Tear down connection, S.state := TIMEWAIT, Set TIMEWAIT timer",
      "to": "TIMEWAIT"
    },
    {
      "from": "OPEN",
      "event": "application events",
      "action": "sends DCCP-Data and DCCP-DataAck packets",
      "to": "OPEN"
    },
    {
      "from": "OPEN",
      "event": "receiving a valid DCCP-Sync packet",
      "action": "generate and send a DCCP-SyncAck response",
      "to": "OPEN"
    },
    {
      "from": "CLOSEREQ",
      "event": "Receive DCCP-Close",
      "action": "Send DCCP-Reset",
      "to": "CLOSED"
    },
    {
      "from": "CLOSEREQ",
      "event": "Send DCCP-Reset",
      "action": "Send DCCP-Reset, clear connection state",
      "to": "CLOSED"
    },
    {
      "from": "CLOSEREQ",
      "event": "Retransmission Timer",
      "action": "Retransmit DCCP-CloseReq",
      "to": "CLOSEREQ"
    },
    {
      "from": "CLOSING",
      "event": "Receive DCCP-Reset",
      "action": "Hold state for 2MSL",
      "to": "TIMEWAIT"
    },
    {
      "from": "CLOSING",
      "event": "Send DCCP-Reset",
      "action": "Send DCCP-Reset, clear connection state",
      "to": "CLOSED"
    },
    {
      "from": "CLOSING",
      "event": "Retransmission Timer",
      "action": "Retransmit DCCP-Close",
      "to": "CLOSING"
    },
    {
      "from": "TIMEWAIT",
      "event": "2MSL wait time",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "TIMEWAIT",
      "event": "Send DCCP-Reset",
      "action": "",
      "to": "CLOSED"
    },
    {
      "from": "STABLE",
      "event": "app/protocol evt",
      "action": "snd Change L",
      "to": "CHANGING"
    },
    {
      "from": "STABLE",
      "event": "rcv Confirm R",
      "action": "ignore",
      "to": "STABLE"
    },
    {
      "from": "STABLE",
      "event": "rcv Change R",
      "action": "calc new value, snd Confirm L",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "rcv Confirm R",
      "action": "Set F.value := new value",
      "to": "STABLE"
    },
    {
      "from": "CHANGING",
      "event": "pref list changes",
      "action": "",
      "to": "UNSTABLE"
    },
    {
      "from": "CHANGING",
      "event": "timeout/rcv non-ack",
      "action": "snd Change L",
      "to": "CHANGING"
    },
    {
      "from": "CHANGING",
      "event": "rcv Change R",
      "action": "examine preference list, reconcile, generate Confirm option",
      "to": "STABLE"
    },
    {
      "from": "UNSTABLE",
      "event": "snd Change L",
      "action": "",
      "to": "CHANGING"
    },
    {
      "from": "UNSTABLE",
      "event": "rcv Confirm/Change R",
      "action": "ignore",
      "to": "UNSTABLE"
    },
    {
      "from": "bidirectional",
      "event": "notices that DCCP B has gone quiescent",
      "action": "switches its ack pattern from bidirectional to unidirectional",
      "to": "unidirectional"
    },
    {
      "from": "unidirectional",
      "event": "must acknowledge even a single DCCP-Data or DCCP-DataAck packet from DCCP B",
      "action": "switches from unidirectional to bidirectional",
      "to": "bidirectional"
    },
