  "transitions": [
    {
      "from": "Control connection established",
      "event": "USER",
      "action": "flush any user, password, and account information already supplied; begin login sequence again",
      "to": "Login sequence initiated"
    },
    {
      "from": "Login sequence initiated",
      "event": "PASS",
      "action": "complete user identification for access control (if account not required)",
      "to": "Logged in"
    },
    {
      "from": "Login sequence initiated",
      "event": "ACCT",
      "action": "provide account information",
      "to": "Logged in"
    },
    {
      "from": "Logged in",
      "event": "REIN",
      "action": "terminate USER; flush all I/O and account information; reset parameters to default settings; leave control connection open",
      "to": "Control connection established"
    },
    {
      "from": "Logged in",
      "event": "QUIT",
      "action": "terminate USER; close control connection if file transfer not in progress",
      "to": "Control connection closed"
    },
    {
      "from": "File transfer in progress",
      "event": "ABOR",
      "action": "abort FTP service command and associated data transfer; close data connection; return 426 reply then 226 reply",
      "to": "Logged in"
    },
    {
      "from": "File transfer in progress",
      "event": "QUIT",
      "action": "terminate USER; keep connection open for result response then close it",
      "to": "Control connection closed"
    },
