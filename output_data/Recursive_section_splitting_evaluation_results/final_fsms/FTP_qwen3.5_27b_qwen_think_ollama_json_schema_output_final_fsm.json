  ],
  "transitions": [
    {
      "from": "Control Connection Opened",
      "event": "RETR",
      "action": "transfer a copy of the file to the server- or user-DTP",
      "to": "File Transfer in Progress"
    },
    {
      "from": "Control Connection Opened",
      "event": "STOR",
      "action": "accept the data transferred via the data connection and store the data as a file",
      "to": "File Transfer in Progress"
    },
    {
      "from": "Control Connection Opened",
      "event": "APPE",
      "action": "accept the data transferred via the data connection and store the data in a file",
      "to": "File Transfer in Progress"
    },
    {
      "from": "Control Connection Opened",
      "event": "STOU",
      "action": "create a file under a name unique to that directory",
      "to": "File Transfer in Progress"
    },
    {
      "from": "File Transfer in Progress",
      "event": "ABOR",
      "action": "abort the previous FTP service command and any associated transfer of data; data connection must be closed",
      "to": "Control Connection Opened"
    },
    {
      "from": "Control Connection Opened",
      "event": "QUIT",
      "action": "server closes the control connection",
      "to": "Connection Closed"
    },
    {
      "from": "File Transfer in Progress",
      "event": "QUIT",
      "action": "connection will remain open for result response and the server will then close it",
      "to": "Connection Closed"
    },
