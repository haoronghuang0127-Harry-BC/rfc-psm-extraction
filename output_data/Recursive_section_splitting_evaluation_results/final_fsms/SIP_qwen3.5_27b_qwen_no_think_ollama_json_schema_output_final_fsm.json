{
  "states": [
    "Session Established",
    "Dialog",
    "Stateless UAS",
    "Stateful UAS",
    "Pending Transaction",
    "Final Response Sent",
    "early",
    "confirmed",
    "terminated",
    "Existing Dialog",
    "INVITE client transaction in progress",
    "INVITE server transaction in progress",
    "Dialog terminated",
    "Early Dialog",
    "Confirmed Dialog",
    "Terminated",
    "stateless",
    "stateful",
    "proceeding",
    "Calling",
    "Proceeding",
    "Completed",
    "Trying"
  ],
  "transitions": [
    {
      "from": "Session Established",
      "event": "re-INVITE",
      "action": "send 200 (OK) to accept change or error response such as 488 (Not Acceptable Here)",
      "to": "Session Established"
    },
    {
      "from": "Session Established",
      "event": "BYE",
      "action": "send 200 (OK) response",
      "to": "Dialog"
    },
    {
      "from": "Pending Transaction",
      "event": "CANCEL request received for INVITE",
      "action": "respond to original request with 487 (Request Terminated); respond to CANCEL with 200 (OK)",
      "to": "Final Response Sent"
    },
    {
      "from": "Pending Transaction",
      "event": "CANCEL request received for non-INVITE",
      "action": "respond to CANCEL with 200 (OK); no impact on original transaction processing",
      "to": "Pending Transaction"
    },
    {
      "from": "Final Response Sent",
      "event": "CANCEL request received",
      "action": "no effect on original request or session state; respond to CANCEL with 200 (OK)",
      "to": "Final Response Sent"
    },
    {
      "from": "early",
      "event": "2xx final response",
      "action": "",
      "to": "confirmed"
    },
    {
      "from": "early",
      "event": "other responses or no response",
      "action": "terminate the dialog",
      "to": "terminated"
    },
    {
      "from": "early",
      "event": "reception of the non-2xx final response",
      "action": "All early dialogs are considered terminated",
      "to": "confirmed"
    },
    {
      "from": "early",
      "event": "reception of a 2xx response",
      "action": "dialog MUST be transitioned to the 'confirmed' state, and the route set for the dialog MUST be recomputed",
      "to": "confirmed"
    },
    {
      "from": "early",
      "event": "reception of a 2xx response matching an existing dialog identifier",
      "action": "dialog MUST be transitioned to the 'confirmed' state, and the route set for the dialog MUST be recomputed",
      "to": "confirmed"
    },
    {
      "from": "Existing Dialog",
      "event": "re-INVITE with non-2xx final response",
      "action": "session parameters remain unchanged",
      "to": "Existing Dialog"
    },
    {
      "from": "Existing Dialog",
      "event": "re-INVITE with 481, 408, or timeout",
      "action": "terminate the dialog",
      "to": "Dialog terminated"
    },
    {
      "from": "Existing Dialog",
      "event": "re-INVITE with 491 response",
      "action": "start timer T and retry re-INVITE after timeout if desired",
      "to": "Existing Dialog"
    },
    {
      "from": "Existing Dialog",
      "event": "second INVITE received before final response to first INVITE with lower CSeq",
      "action": "return 500 (Server Internal Error) with Retry-After header",
      "to": "Existing Dialog"
    },
    {
      "from": "INVITE server transaction in progress",
      "event": "received INVITE on dialog",
      "action": "return 491 (Request Pending)",
      "to": "INVITE server transaction in progress"
    },
    {
      "from": "Existing Dialog",
      "event": "re-INVITE with changed session description accepted",
      "action": "adjust session parameters accordingly",
      "to": "Existing Dialog"
    },
    {
      "from": "Existing Dialog",
      "event": "re-INVITE with unacceptable session description",
      "action": "return 488 (Not Acceptable Here) response",
      "to": "Existing Dialog"
    },
    {
      "from": "Existing Dialog",
      "event": "2xx response generated without receiving ACK",
      "action": "generate BYE to terminate the dialog",
      "to": "Dialog terminated"
    },
    {
      "from": "Early Dialog",
      "event": "BYE request from caller's UA",
      "action": "terminate session",
      "to": "Terminated"
    },
    {
      "from": "Confirmed Dialog",
      "event": "BYE request",
      "action": "terminate session",
      "to": "Terminated"
    },
    {
      "from": "Early Dialog",
      "event": "non-2xx final response to INVITE",
      "action": "terminate all sessions and dialogs",
      "to": "Terminated"
    },
    {
      "from": "Confirmed Dialog",
      "event": "CANCEL request resulting in 487",
      "action": "terminate session",
      "to": "Terminated"
    },
    {
      "from": "stateful",
      "event": "",
      "action": "discard all state",
      "to": "stateless"
    },
    {
      "from": "Calling",
      "event": "Timer A fires",
      "action": "retransmit the request; reset timer A with value 2*T1",
      "to": "Calling"
    },
    {
      "from": "Calling",
      "event": "Timer B fires",
      "action": "inform TU that a timeout has occurred",
      "to": "Terminated"
    },
    {
      "from": "Calling",
      "event": "Transport Error",
      "action": "inform TU",
      "to": "Terminated"
    },
    {
      "from": "Calling",
      "event": "provisional response (1xx)",
      "action": "pass response to TU; stop retransmitting request",
      "to": "Proceeding"
    },
    {
      "from": "Calling",
      "event": "response with status code 300-699",
      "action": "pass response to TU; generate and send ACK; start Timer D",
      "to": "Completed"
    },
    {
      "from": "Proceeding",
      "event": "Timer B fires",
      "action": "inform TU that a timeout has occurred",
      "to": "Terminated"
    },
    {
      "from": "Proceeding",
      "event": "Transport Error",
      "action": "inform TU",
      "to": "Terminated"
    },
    {
      "from": "Proceeding",
      "event": "response with status code 300-699",
      "action": "pass response to TU; generate and send ACK; start Timer D",
      "to": "Completed"
    },
    {
      "from": "Proceeding",
      "event": "2xx response",
      "action": "pass response to TU",
      "to": "Terminated"
    },
    {
      "from": "Completed",
      "event": "retransmission of final response",
      "action": "re-pass ACK to transport layer; do not pass response to TU",
      "to": "Completed"
    },
    {
      "from": "Completed",
      "event": "Timer D fires",
      "action": "",
      "to": "Terminated"
    },
    {
      "from": "Trying",
      "event": "Timer E fires",
      "action": "retransmit request; reset Timer E with value MIN(2*T1, T2)",
      "to": "Trying"
    },
    {
      "from": "Trying",
      "event": "Timer F fires",
      "action": "inform TU about timeout",
      "to": "Terminated"
    },
    {
      "from": "Trying",
      "event": "Transport Error",
      "action": "inform TU",
      "to": "Terminated"
    },
    {
      "from": "Trying",
      "event": "provisional response (1xx)",
      "action": "pass response to TU",
      "to": "Proceeding"
    },
    {
      "from": "Trying",
      "event": "final response (200-699)",
      "action": "pass response to TU",
      "to": "Completed"
    },
    {
      "from": "Proceeding",
