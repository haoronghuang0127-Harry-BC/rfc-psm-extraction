{
  "states": [
    "Connected",
    "Session",
    "Token acquisition",
    "Verification",
    "Waiting for CONNACK",
    "Authenticating",
    "Unauthorized",
    "Disconnected",
    "Retained Message Active",
    "New Session",
    "Session State Maintained"
  ],
  "transitions": [
    {
      "from": "Connected",
      "event": "PUBLISH",
      "action": "relay messages to subscribers",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "SUBSCRIBE",
      "action": "",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "PINGREQ",
      "action": "confirm Broker is alive",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "DISCONNECT",
      "action": "publish Will Message if applicable",
      "to": "Session"
    },
    {
      "from": "Session",
      "event": "CONNECT",
      "action": "connection acknowledgment",
      "to": "Connected"
    },
    {
      "from": "Token acquisition",
      "event": "Token request",
      "action": "verify request",
      "to": "Verification"
    },
    {
      "from": "Verification",
      "event": "successful verification and authorization",
      "action": "issues an access token",
      "to": "Token acquisition"
    },
    {
      "from": "Waiting for CONNACK",
      "event": "DISCONNECT",
      "action": "",
      "to": "Waiting for CONNACK"
    },
    {
      "from": "Waiting for CONNACK",
      "event": "AUTH",
      "action": "",
      "to": "Authenticating"
    },
    {
      "from": "Authenticating",
      "event": "AUTH",
      "action": "0x18 (Continue Authentication)",
      "to": "Authenticating"
    },
    {
      "from": "Authenticating",
      "event": "Token validation",
      "action": "Token validation",
      "to": "Waiting for CONNACK"
    },
    {
      "from": "Connected",
      "event": "PUBLISH or SUBSCRIBE",
      "action": "introspect token or use cached validation result",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "",
      "action": "set Session Present to 0",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "",
      "action": "set Session Present to 1",
      "to": "Connected"
    },
    {
      "from": "Unauthorized",
      "event": "Authentication Failure",
      "action": "respond with CONNACK reason code 0x87",
      "to": "Unauthorized"
    },
    {
      "from": "Unauthorized",
      "event": "Authentication Failure",
      "action": "trigger AS discovery, include User Property",
      "to": "Unauthorized"
    },
    {
      "from": "Connected",
      "event": "Client DISCONNECT",
      "action": "keep retained messages, MAY store Session State",
      "to": "Disconnected"
    },
    {
      "from": "Disconnected",
      "event": "network errors or server disconnection due to a protocol error",
      "action": "send Will Message",
      "to": "Disconnected"
    },
    {
      "from": "Connected",
      "event": "PUBLISH packet with RETAIN flag set",
      "action": "store message",
      "to": "Retained Message Active"
    },
    {
      "from": "Retained Message Active",
      "event": "new subscriber",
      "action": "publish retained message",
      "to": "Retained Message Active"
    },
    {
      "from": "Retained Message Active",
      "event": "token expiry or message expiry interval",
      "action": "discard retained message",
      "to": "Disconnected"
    },
    {
      "from": "Disconnected",
      "event": "CONNECT without a token",
      "action": "disconnect",
      "to": "Disconnected"
    },
    {
      "from": "Connected",
      "event": "Client-Broker PUBLISH authorization failure",
      "action": "disconnect",
      "to": "Disconnected"
    },
    {
      "from": "Connected",
      "event": "SUBSCRIBE authorization failure",
      "action": "return 0x80 reason code",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "Broker-Client PUBLISH authorization failure",
      "action": "disconnect",
      "to": "Disconnected"
    },
    {
      "from": "Disconnected",
      "event": "CONNECT with token",
      "action": "PoP validation",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "Clean flag = 1",
      "action": "start a new Session",
      "to": "New Session"
    },
    {
      "from": "Connected",
      "event": "Clean flag = 0",
      "action": "resume communications based on current Session",
      "to": "Connected"
    },
    {
      "from": "New Session",
      "event": "",
      "action": "create a new Session",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "Client's permissions revoked",
      "action": "may grant publish/subscribe to revoked topics",
      "to": "Connected"
    },
    {
      "from": "Connected",
      "event": "access token validated",
      "action": "cache the token",
      "to": "Session State Maintained"
    },
    {
      "from": "Session State Maintained",
      "event": "permissions change dynamically",
      "action": "AS follows a reasonable expiration strategy for the access tokens",
      "to": "Session State Maintained"
    },
    {
      "from": "Session State Maintained",
      "event": "reasonable cache timeout",
      "action": "introspect tokens regularly",
      "to": "Session State Maintained"
    }
  ]
}