{
  "states": [
    "early",
    "confirmed",
    "terminated",
    "stateful",
    "stateless",
    "Calling",
    "Proceeding",
    "Completed",
    "Terminated",
    "Trying"
  ],
  "transitions": [
    {
      "from": "early",
      "event": "",
      "action": "2xx final response arrives",
      "to": "confirmed"
    },
    {
      "from": "early",
      "event": "other responses or no response arrives",
      "action": "terminate",
      "to": "terminated"
    },
    {
      "from": "early",
      "event": "",
      "action": "dialog transitioned to confirmed state",
      "to": "confirmed"
    },
    {
      "from": "early",
      "event": "non-2xx final response",
      "action": "all early dialogs terminated",
      "to": "terminated"
    },
    {
      "from": "stateful",
      "event": "",
      "action": "transition to stateless operation",
      "to": "stateless"
    },
    {
      "from": "stateless",
      "event": "",
      "action": "",
      "to": "stateful"
    },
    {
      "from": "Calling",
      "event": "INVITE from TU",
      "action": "",
      "to": "Calling"
    },
    {
      "from": "Calling",
      "event": "Timer A fires",
      "action": "Reset A, INVITE sent",
      "to": "Calling"
    },
    {
      "from": "Calling",
      "event": "Timer B fires",
      "action": "inform TU",
      "to": "Terminated"
    },
    {
      "from": "Calling",
      "event": "1xx",
      "action": "1xx to TU",
      "to": "Proceeding"
    },
    {
      "from": "Calling",
      "event": "2xx",
      "action": "2xx to TU",
      "to": "Terminated"
    },
    {
      "from": "Calling",
      "event": "300-699",
      "action": "ACK sent, resp. to TU",
      "to": "Completed"
    },
    {
      "from": "Proceeding",
      "event": "2xx",
      "action": "2xx to TU",
      "to": "Terminated"
    },
    {
      "from": "Proceeding",
      "event": "300-699",
      "action": "ACK sent, resp. to TU",
      "to": "Completed"
    },
    {
      "from": "Completed",
      "event": "Timer D fires",
      "action": "",
      "to": "Terminated"
    },
    {
      "from": "Trying",
      "event": "",
      "action": "pass request to TU",
      "to": "Proceeding"
    },
    {
      "from": "Trying",
      "event": "TU passes 1xx response",
      "action": "send response, enter Proceeding state",
      "to": "Proceeding"
    },
    {
      "from": "Proceeding",
      "event": "TU passes 2xx response",
      "action": "send response, transition to Terminated",
      "to": "Terminated"
    },
    {
      "from": "Proceeding",
      "event": "TU passes 300-699 response",
      "action": "send response, enter Completed state",
      "to": "Completed"
    },
    {
      "from": "Completed",
      "event": "ACK received",
      "action": "",
      "to": "Confirmed"
    },
    {
      "from": "Completed",
      "event": "Timer H fires",
      "action": "indicate transaction failure to TU",
      "to": "Terminated"
    },
    {
      "from": "Completed",
      "event": "Transport Error",
      "action": "inform TU",
      "to": "Terminated"
    },
    {
      "from": "Confirmed",
      "event": "Timer I fires",
      "action": "",
      "to": "Terminated"
    }
  ]
}